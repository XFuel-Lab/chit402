{
  "about": "ChitAnchor on Base Sepolia. Run from the repo root: node scripts/mutants/run-mutants.mjs . --list test/chit-simple/mutants.json --timeout-sec 180. Score is KILLED / (KILLED + SURVIVED). forge and node must be on PATH. The anchor suite runs pretest.sh, then forge test --force, skipping invariant fuzz and test_example_runtime_code_hash. The checkDeploy suite runs the offline Safe check. A2 and A13-A16 are retired in the retired list. R19 matches the inner shift at 20-space indent.",
  "timeoutSec": 180,
  "suites": {
    "anchor": {
      "cwd": "test/chit-simple",
      "argv": [
        "sh",
        "-c",
        "sh pretest.sh >/dev/null && forge test --force --offline --no-match-contract Invariant --no-match-test test_example_runtime_code_hash"
      ],
      "env": {
        "FOUNDRY_DISABLE_NIGHTLY_WARNING": "1"
      }
    },
    "checkDeploy": {
      "cwd": "deploy/chit-simple/sepolia-pack",
      "argv": [
        "node",
        "--test",
        "check-deploy.test.mjs"
      ],
      "env": {
        "FOUNDRY_DISABLE_NIGHTLY_WARNING": "1"
      }
    }
  },
  "mutants": [
