{
  "name": "xfuel-mcp",
  "version": "0.1.0",
  "description": "First-party Model Context Protocol (MCP) server for the XFuel Protocol — submit AI inference, quote/price tasks, fetch ZK proofs, and verify them from any MCP client. Runs over stdio or streamable HTTP.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "xfuel-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "xfuel",
    "mcp",
    "model-context-protocol",
    "ai",
    "depin",
    "zk",
    "sp1",
    "theta",
    "inference",
    "agent-tools"
  ],
  "author": "XFuel Protocol",
  "license": "Apache-2.0",
  "homepage": "https://github.com/XFuel-Lab/xfuel-protocol/tree/main/xfuel-mcp#readme",
  "bugs": {
    "url": "https://github.com/XFuel-Lab/xfuel-protocol/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/XFuel-Lab/xfuel-protocol.git",
    "directory": "xfuel-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "xfuel-sdk": "file:../sdk/js",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.10.6",
    "tsx": "^4.19.2",
    "typescript": "^5.2.2"
  }
}
