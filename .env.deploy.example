# ============================================================
# XFuel Protocol — Deployment Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# All addresses should be checksummed (EIP-55).
# See docs/DEPLOYMENT.md for full deployment instructions.
# ============================================================

# ─── Deployer ───────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=           # Deployer wallet private key (funded with TFUEL for gas)
PRIVATE_KEY=                    # Alias for DEPLOYER_PRIVATE_KEY (used by some scripts)

# ─── Core Addresses ─────────────────────────────────────────
ADMIN_ADDRESS=                  # Multisig admin address (receives DEFAULT_ADMIN_ROLE)
BBB_ADDRESS=                    # Buyback & Burn wallet (receives 30% of fees)
GET_ADDRESS=                    # Growth/Expansion/Treasury wallet (receives 30% of fees)
STAKER_ADDRESS=                 # Staker vault address (receives 25% of fees)
TREASURY_ADDRESS=               # Treasury wallet (receives 15% of fees)
STAKE_POOL_ADDRESS=             # Fee-to-Stake pool contract

# ─── SP1 Verification ───────────────────────────────────────
SP1_GATEWAY_ADDRESS=            # SP1 Verifier Gateway (address(0) for mock mode)
SP1_PROVER=cuda                 # Prover backend: cuda | network | mock
SP1_PRIVATE_KEY=                # Network prover auth key (if using Succinct network)

# ─── Token Addresses ────────────────────────────────────────
XF_TOKEN_ADDRESS=               # XF ERC-20 token contract (address(0) for mock governance)
USDC_ADDRESS=                   # USDC token contract (optional)

# ─── RPC Endpoints ──────────────────────────────────────────
THETA_RPC_URL=https://eth-rpc-api.thetatoken.org/rpc
THETA_TESTNET_RPC_URL=https://eth-rpc-api-testnet.thetatoken.org/rpc
BITTENSOR_RPC_URL=https://lite.chain.opentensor.ai
BITTENSOR_TESTNET_RPC_URL=https://test.chain.opentensor.ai

# ─── Theta EdgeCloud (SP1 Prover) ───────────────────────────
THETA_BRIDGE_RPC=https://eth-rpc-api-testnet.thetatoken.org/rpc
THETA_BRIDGE_PRIVATE_KEY=       # Bridge relayer private key
THETA_BRIDGE_CONTRACT=          # Bridge contract address on Theta

# ─── Hyperlane Cross-Chain ───────────────────────────────────
HYPERLANE_MAILBOX=              # Hyperlane Mailbox contract address
HYPERLANE_ISM=                  # Interchain Security Module address

# ─── Block Explorer API Keys (for contract verification) ────
ETHERSCAN_API_KEY=              # Etherscan-compatible API key
THETA_EXPLORER_API_KEY=         # Theta Explorer API key
