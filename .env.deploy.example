# XFuel Protocol — Deployment Environment Variables
# Copy to .env.local and fill in. See docs/DEPLOYMENT.md and docs/RUNTIME_STATE.md.
#
# Go-forward: Base settlement (USDC / x402) + ZKVerifierSP1 on Base.
#   npx hardhat run deploy/base-verifier.cjs --network base-sepolia
#   npx hardhat run deploy/base-verifier.cjs --network base
#
# Historical Theta full deploys (CoreRevenueSplitter / BelieverRound) live under
# deploy/*.cjs for archive/ops only — not the product fee path (ADR 0001 / 0002).

# ─── Deployer ───────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=
PRIVATE_KEY=                    # Alias for DEPLOYER_PRIVATE_KEY

# ─── Core (Base) ────────────────────────────────────────────
ADMIN_ADDRESS=                  # Multisig / Safe admin
X402_PAY_TO=                    # Protocol USDC fee sink on Base (Safe / Splits)
REVENUE_SPLIT_ADDRESS=          # Optional Splits v2 address
SP1_GATEWAY_ADDRESS=            # SP1 Verifier Gateway (0x0 for mock)
XF_TOKEN_ADDRESS=               # Optional; post-TGE on Base

# ─── SP1 Prover ─────────────────────────────────────────────
SP1_PROVER=cuda                 # cuda | network | mock
SP1_PRIVATE_KEY=                # Succinct network auth (if used)
SP1_PROVER_URL=                 # Gateway → live prover ALB (see RUNTIME_STATE)

# ─── Gateway x402 (Base) ────────────────────────────────────
X402_ENABLED=true
X402_NETWORK=base-sepolia       # base-sepolia | base
X402_FACILITATOR_URL=https://x402.org/facilitator

# ─── Optional provider ops (NOT settlement home) ────────────
# THETA_RPC_URL=                # EdgeCloud / Theta ETH-RPC only if needed
# EDGECLOUD_API_KEY=
