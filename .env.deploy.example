# ============================================================
# XFuel Protocol — Deployment Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# All addresses should be checksummed (EIP-55).
# See docs/DEPLOYMENT.md for full deployment instructions.
#
# DEPLOYMENT SEQUENCE (industry practice):
#   1. Testnet first: npx hardhat run deploy/full.cjs --network theta-testnet
#   2. Grant application: submit with testnet addresses + Explorer links
#   3. CertiK audit (Q2 2026): post-grant funding
#   4. Mainnet: npx hardhat run deploy/full.cjs --network theta-mainnet (post-audit only)
#
# MINIMUM VIABLE DEPLOYMENT (Theta-only, no Hyperlane):
#   Set DEPLOYER_PRIVATE_KEY, ADMIN_ADDRESS, BBB_ADDRESS, GET_ADDRESS,
#   STAKER_ADDRESS, TREASURY_ADDRESS — leave everything else blank/0x0.
#   SP1_GATEWAY_ADDRESS=0x0 enables mock ZK mode.
#   XF_TOKEN_ADDRESS=0x0 skips veXFGovernance (can deploy separately later).
# ============================================================

# ─── Deployer ───────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=           # Deployer wallet private key (funded with TFUEL for gas)
PRIVATE_KEY=                    # Alias for DEPLOYER_PRIVATE_KEY (used by some scripts)

# ─── Core Addresses ─────────────────────────────────────────
ADMIN_ADDRESS=                  # Multisig admin address (receives DEFAULT_ADMIN_ROLE)
BBB_ADDRESS=                    # Buyback & Burn wallet (receives 30% of fees)
GET_ADDRESS=                    # Growth/Expansion/Treasury wallet (receives 30% of fees)
STAKER_ADDRESS=                 # Staker vault address (receives 25% of fees)
TREASURY_ADDRESS=               # Treasury wallet (receives 15% of fees)
STAKE_POOL_ADDRESS=             # Fee-to-Stake pool contract

# ─── SP1 Verification ───────────────────────────────────────
SP1_GATEWAY_ADDRESS=            # SP1 Verifier Gateway (address(0) for mock mode)
SP1_PROVER=cuda                 # Prover backend: cuda | network | mock
SP1_PRIVATE_KEY=                # Network prover auth key (if using Succinct network)

# ─── Token Addresses ────────────────────────────────────────
XF_TOKEN_ADDRESS=               # XF ERC-20 token contract (address(0) for mock governance)

# ─── Multi-Chain Stake Routing (optional) ───────────────────
THETA_STAKE_POOL=               # wTHETA/TFUEL staking pool on Theta (50% weight when set)
BITTENSOR_STAKE_POOL=           # dTAO staking relay on Bittensor EVM (30% weight when set)
OSMOSIS_STAKE_POOL=             # IBC relay for Osmosis native staking (20% weight when set)
# Note: If none are set, fee-to-stake routes to STAKE_POOL_ADDRESS fallback

# ─── RPC Endpoints ──────────────────────────────────────────
THETA_RPC_URL=https://eth-rpc-api.thetatoken.org/rpc
THETA_TESTNET_RPC_URL=https://eth-rpc-api-testnet.thetatoken.org/rpc
BITTENSOR_RPC_URL=https://lite.chain.opentensor.ai
BITTENSOR_TESTNET_RPC_URL=https://test.chain.opentensor.ai

# ─── Theta EdgeCloud (SP1 Prover) ───────────────────────────
THETA_BRIDGE_RPC=https://eth-rpc-api-testnet.thetatoken.org/rpc
THETA_BRIDGE_PRIVATE_KEY=       # Bridge relayer private key
THETA_BRIDGE_CONTRACT=          # Bridge contract address on Theta

# ─── DePIN Priority Router ───────────────────────────────────
# Route order: Theta EdgeCloud → RapidAPI → MCP → Akash → Render → Bedrock
# All external providers are pay-as-you-go — zero idle cost.
# Leave blank to skip that tier; router automatically skips unconfigured tiers.

# Akash Network (DePIN tier 1 — decentralised GPU marketplace on Cosmos)
AKASH_WALLET_MNEMONIC=          # BIP-39 mnemonic for Akash deployer wallet
AKASH_CERT_PEM=                 # TLS client certificate for provider authentication
AKASH_GATEWAY_URL=              # Gateway endpoint (defaults to api.akash.network)

# Render Network (DePIN tier 2 — GPU marketplace, strong for image workloads)
RENDER_API_KEY=                 # API key from render.com dashboard
RENDER_API_BASE=                # Override base URL (defaults to api.render.com/v1)

# AWS Bedrock (cloud last resort — centralized; only used when all DePINs fail)
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY already set above for Secrets Manager.
# AWS_REGION controls the Bedrock endpoint region.
AWS_REGION=us-east-1

# ─── Theta EdgeStore (Track 3.1) ────────────────────────────────
# Wallet that signs EdgeStore auth tokens.
# Auth token: `${timestamp}.${walletAddress}.${eth_sign("Theta EdgeStore Call ${timestamp}")}`
# Token expiry: 24h (adapter auto-refreshes). Upload API: api.thetaedgestore.com
# Retrieve API: data.thetaedgestore.com/api/v2/data/<key>
THETA_EDGESTORE_WALLET_KEY=         # Private key (0x…) of the EdgeStore signing wallet

# ─── Theta Video API (Track 3.2 + 3.3) ──────────────────────────
# Service Account credentials from https://studio.thetatoken.org
# SA ID and secret go into the Authorization: Basic header for all Video API calls.
THETA_VIDEO_SA_ID=                  # Service Account ID (srvacc_…)
THETA_VIDEO_SA_SECRET=              # Service Account Secret

# ─── TDROP Payment Option (Track 4.2) ───────────────────────────
# TDROP is Theta's designated AI-to-AI incentive token (TNT-20 / ERC-20 compatible).
# Set these to enable TDROP payment in ThetaInferenceCircuit + A2ACircuit.
# Callers who pay in TDROP receive a 20% fee discount (tdropDiscountBps default).
#
# Mainnet TDROP contract: 0x1336739B05C7Ab8a526D40DCC0d04a826b5f8B03 (chainId 361)
# Testnet TDROP contract: 0xde41591ED1f8ED1484aC2CD8ca0876428de60EfF (chainId 365)
#
# After deployment, call ThetaInferenceCircuit.setTdropConfig(TDROP_CONTRACT_ADDRESS, 2000, 1e18)
# to enable TDROP payments with a 20% discount and 1:1 TDROP/TFUEL rate.
# Update TDROP_PER_TFUEL_RATE as TDROP market price changes (or wire a Chainlink feed).
TDROP_CONTRACT_ADDRESS=             # TNT-20 TDROP address for the target network
TDROP_DISCOUNT_BPS=2000             # Fee discount for TDROP payers (default 20% = 2000 BPS)
TDROP_PER_TFUEL_RATE=1000000000000000000  # TDROP wei per 1 TFUEL wei (1:1 = 1e18)

# ─── Webhook Security (Track 5.5) ─────────────────────────────
# HMAC-SHA256 key added to all outbound webhook POST headers as X-XFuel-Signature: sha256=<hex>
# Receivers verify using: crypto.timingSafeEqual(expected, received)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=                     # 32-byte hex secret for webhook HMAC signing (optional but recommended)

# ─── Hyperlane Cross-Chain ───────────────────────────────────
# Used by ZKVerifierSP1.setMailbox() and TAOCircuit.setMailbox()
# Deploy via: node scripts/hyperlane-init.cjs (then hyperlane core deploy)
HYPERLANE_MAILBOX=              # Hyperlane Mailbox address (current network, generic)
HYPERLANE_MAILBOX_THETA_MAINNET= # Theta Mainnet (361) Mailbox — post hyperlane core deploy
HYPERLANE_MAILBOX_THETA=        # Theta Testnet (365) Mailbox — post hyperlane core deploy
HYPERLANE_MAILBOX_BITTENSOR=    # Bittensor EVM (945/964) Mailbox — Phase 2
HYPERLANE_ISM=                  # Interchain Security Module address

# ─── Block Explorer API Keys (for contract verification) ────
ETHERSCAN_API_KEY=              # Etherscan-compatible API key
THETA_EXPLORER_API_KEY=         # Theta Explorer API key
