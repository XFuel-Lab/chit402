  "keys": {
    "getter": "keys(bytes32)",
    "returns": [
      {
        "name": "status",
        "type": "uint8",
        "notes": "0 none, 1 standby, 2 active, 3 retired, 4 revoked"
      },
      {
        "name": "wasActive",
        "type": "bool",
        "notes": "true once the key has been active, including after revoke"
      },
      {
        "name": "notBefore",
        "type": "uint64"
      },
      {
        "name": "notAfter",
        "type": "uint64",
        "notes": "0 means open"
      },
      {
        "name": "revokedAt",
        "type": "uint64",
        "notes": "0 means not revoked"
      },
      {
        "name": "activatedAt",
        "type": "uint64",
        "notes": "0 until PROMOTE; genesis sets this to notBefore. Validity starts at max(notBefore, activatedAt)."
      }
    ],
    "slots": {
      "perKey": 2,
      "base": "keccak256(abi.encode(kid, uint256(4)))",
      "slot0": "status | wasActive | notBefore | notAfter | revokedAt",
      "slot1": "activatedAt in the low 64 bits"
    }
  },
  "rootHash": {
    "domains": {
      "GENESIS_DOMAIN": "keccak256(\"chit.issuerRoot.genesis.v1\")",
      "COMMIT_DOMAIN": "keccak256(\"chit.issuerRoot.commit.v1\")",
      "WITNESS_POP_DOMAIN": "keccak256(\"chit.issuerRoot.witnessPop.v1\")",
      "RECOVER_AUTH_DOMAIN": "keccak256(\"chit.issuerRoot.recoverAuth.v1\")",
      "RECOVER_ROOT_DOMAIN": "keccak256(\"chit.issuerRoot.recoverRoot.v1\")",
      "GUARDIAN_AUTH_DOMAIN": "keccak256(\"chit.issuerRoot.guardianAuth.v1\")",
      "GUARDIAN_ROOT_DOMAIN": "keccak256(\"chit.issuerRoot.guardianRoot.v1\")"
    },
    "genesis": {
      "when": "constructor, stored at rootSeq 0",
      "preimage": "keccak256(abi.encode(GENESIS_DOMAIN, GenesisStatic, guardians)). GenesisStatic is chainId, registry, controller, genesisKid, genesisNotBefore, activatedAt, blockNumber, witnessSalt, guardianSeq, guardianThreshold, historyVersion, historySnapshot. historyVersion and historySnapshot are 0.",
      "activatedAt": "genesisNotBefore",
      "events": [
        "KeyActivated(kid, activatedAt, 0)",
        "GenesisSeeded(controller, kid, notBefore, activatedAt, blockNumber, rootHash)",
        "GuardianSetCommitted(guardianSeq, guardianThreshold, guardianSetHash, guardians, blockNumber)"
      ]
    },
    "commit": {
      "when": "commit(), rootSeq increments from the previous value",
      "preimage": "opsHash = keccak256(abi.encode(ops)); freezeHash = keccak256(abi.encode(freezeArgs)); keccak256(abi.encode(COMMIT_DOMAIN, CommitStatic)). CommitStatic is prevRootHash, rootSeq, chainId, registry, blockNumber, historyVersion, historySnapshot, guardianSeq, guardianSetHash, opsHash, freezeHash.",
      "blockNumber": "uint64(block.number) of the commit. This is frozenBlock for every freeze in the transaction. A reorg that replays the calldata in another block changes rootHash.",
      "blockhash": "Not stored. blockhash(block.number) is zero inside the transaction. Verifiers read the hash of the RootCommitted or Frozen log's block after it is sealed.",
      "events": [
        "one key or freeze event per argument, then RootCommitted(rootSeq, rootHash, historyVersion, historySnapshot, blockNumber)"
      ]
    },
    "op": {
      "type": "(uint8 kind, bytes32 kid, uint64 timestamp, uint8 reasonCode)",
      "kinds": {
        "1": "ADD_STANDBY",
        "2": "PROMOTE",
        "3": "RETIRE",
        "4": "REVOKE"
      },
      "reasonCode": {
        "1": "compromise, guardian recover only",
        "2": "superseded",
        "3": "lost",
        "255": "other"
      }
    },
    "freezeArg": "(bytes32 universeId, bytes32 universeHash, uint64 enumeratedCount)",
    "note": "Field names and the struct layouts are defined in docs/product/issuer-root.md. Commit hashes ops and freezes as keccak256(abi.encode(...)) inside CommitStatic.",
    "recover": {
      "event": "KeyRecovered(kid, retiredAt, retirementBlock, invalidatePrior, reasonCode, guardianSeq, rootSeq)",
      "preimage": "keccak256(abi.encode(RECOVER_ROOT_DOMAIN, RecoverStatic))"
    },
    "guardianRotation": {
      "event": "GuardianSetCommitted(guardianSeq, guardianThreshold, guardianSetHash, guardians, blockNumber)",
      "preimage": "keccak256(abi.encode(GUARDIAN_ROOT_DOMAIN, GuardianStatic, guardians))"
    }
  }
}
