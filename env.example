# ============================================
# XFUEL Protocol - Environment Configuration
# ============================================
# 
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# ============================================
# THETA NETWORK
# ============================================
THETA_RPC_URL=https://eth-rpc-api.thetatoken.org/rpc
THETA_DEPOSIT_ADDRESS=0x6256D8A728aA102Aa06B6B239ba1247Bd835d816

# ============================================
# PERSISTENCE CHAIN (MAINNET)
# ============================================
PERSISTENCE_RPC_URL=https://rpc.core.persistence.one
PERSISTENCE_REST_URL=https://rest.core.persistence.one

# Dexter DEX Router (Real Mainnet Address ✅)
# Persistence DEX Router: persistence132xmxm33vwjlur2pszl4hu9r32lqmqagvunnuc5hq4htps7rr3kqsf4dsk
# Ref: https://docs.persistence.one/products/persistence-dex-v1/technical-architecture
PERSISTENCE_DEXTER_ROUTER=persistence132xmxm33vwjlur2pszl4hu9r32lqmqagvunnuc5hq4htps7rr3kqsf4dsk

# pStake Staking Contract (DEPRECATED as of Dec 2025)
# ERC-20 stkXPRT deprecated. Use native XPRT staking on Persistence instead.
# Leave empty or set to your custom staking contract if applicable
PSTAKE_STAKING_CONTRACT=

# ============================================
# IBC CONFIGURATION
# ============================================
# IBC Channel: Theta → Persistence
# Status: https://www.mintscan.io/persistence/relayers
IBC_CHANNEL=channel-190

# TFUEL IBC denomination on Persistence chain
# Format: ibc/[hash of transfer/channel-190/tfuel]
# TODO: Get actual IBC denom hash from Persistence after first IBC transfer
# Example: ibc/27394FB092D2ECCD56123C74F36E4C1F926001CEADA9CA97EA622B25F41E5EB2
TFUEL_IBC_DENOM=

# 🔐 IBC Wallet Mnemonic (NEVER COMMIT THIS!)
# Generate a new wallet for IBC operations only
IBC_WALLET_MNEMONIC="your twelve word mnemonic phrase here never share this"

# ============================================
# BACKEND SERVICE
# ============================================
IBC_PORT=3002
DB_FILE=backend/ibc/transactions.json

# ============================================
# OPTIONAL: PRICE FEEDS
# ============================================
# COINGECKO_API_KEY=your_api_key_here

