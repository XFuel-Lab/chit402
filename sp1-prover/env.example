# SP1 prover host — example environment
# Copy to .env or export before `cargo run -- serve`

# GPU backend (optional)
# SP1_PROVER=cuda
# CUDA_PATH=C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.3

# Phase 2: x402 payment binding — v2 public values layout (13 fields).
# Requires rebuilt guest ELF + new programVKey registered on ZKVerifierSP1.
# Only selects v2 when the proof request carries a non-zero payment_commitment.
SP1_PUBLIC_VALUES_V2=false
