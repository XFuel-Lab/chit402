{
  "buildCommand": "cd apps/web && npm install && tsc -b && npx vite build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install --legacy-peer-deps",
  "env": {
    "VITE_MAINTENANCE": "false"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
