{
  "buildCommand": "cd apps/web && npm install && tsc -b && npx vite build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install --legacy-peer-deps",
  "env": {
    "VITE_MAINTENANCE": "false"
  },
  "headers": [
    {
      "source": "/xfuel-icon.svg",
      "headers": [{ "key": "Content-Type", "value": "image/svg+xml; charset=utf-8" }]
    }
  ],
  "rewrites": [
    { "source": "/xfuel-icon.svg", "destination": "/xfuel-icon.svg" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
