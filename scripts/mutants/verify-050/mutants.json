      "find": "if \\(input\\.finalizedNumber == null\\) return 'finality_unavailable';",
      "replace": "if (input.finalizedNumber == null) return 'ok';",
      "nth": 1,
      "suite": "verify"
    },
    {
      "id": "PARSE_missing_member",
      "file": "packages/verify/src/v13/core/decide.ts",
      "find": "if \\(!isPlain\\(payload\\) \\|\\| !hasOwn\\(payload, 'contracts'\\)\\) return \\{ ok: true, pins: \\[\\] \\};",
      "replace": "if (!isPlain(payload) || !hasOwn(payload, 'contracts')) return { ok: false, reason: 'snapshot_contracts_invalid' };",
      "nth": 1,
      "suite": "verify"
    },
    {
      "id": "PARSE_not_array",
