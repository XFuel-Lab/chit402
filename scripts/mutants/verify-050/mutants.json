      "replace": "if (!Array.isArray(list)) return { ok: true, pins: [] };",
      "nth": 1,
      "suite": "verify"
    },
    {
      "id": "PARSE_item_shape",
      "file": "packages/verify/src/v13/core/decide.ts",
      "find": "if \\(!isPlain\\(item\\)\\) return \\{ ok: false, reason: 'snapshot_contracts_invalid' \\};",
      "replace": "if (!isPlain(item)) continue;",
      "nth": 1,
      "suite": "verify"
    },
    {
      "id": "PARSE_genesis",
      "file": "packages/verify/src/v13/core/decide.ts",
      "find": "const genesis = safeUint\\(item\\.genesisHourStart\\);",
      "replace": "const genesis = 1;",
      "nth": 1,
      "suite": "verify"
    },
    {
      "id": "PARSE_retire_order",
      "file": "packages/verify/src/v13/core/decide.ts",
      "find": "if \\(retire != null && retire < genesis\\) return \\{ ok: false, reason: 'snapshot_contracts_invalid' \\};",
      "replace": "if (false) return { ok: false, reason: 'snapshot_contracts_invalid' };",
      "nth": 1,
      "suite": "verify"
    },
    {
      "id": "X1_payer_checked_on_exit_2",
      "file": "packages/verify/src/index.ts",
      "find": "payer: \\{ checked: exit === 0, valid: exit === 0,",
      "replace": "payer: { checked: true, valid: true,",
      "nth": 1,
      "suite": "v13exit"
    },
    {
      "id": "PARSE_checkpoint_versions",
      "file": "packages/verify/src/v13/core/decide.ts",
      "find": "if \\(hasOwn\\(item, 'checkpointVersions'\\)\\) \\{",
      "replace": "if (false && hasOwn(item, 'checkpointVersions')) {",
      "nth": 1,
      "suite": "verify"
    }
  ]
}
