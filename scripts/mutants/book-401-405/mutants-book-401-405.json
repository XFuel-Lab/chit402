      "flags": "",
      "replace": "return res.status(result.status).end();",
      "nth": 1,
      "suite": "gwbook",
      "note": "read-path 401 back to .end()"
    },
    {
      "id": "A2_hint_dropped_budget",
      "file": "services/gateway/src/server.js",
      "find": "if \\(set\\.status === 401\\) return sendBookPossessionRequired\\(req, res, BOOK_POSSESSION_REQUIRED_BODY\\);",
      "flags": "",
      "replace": "return res.status(set.status).end();",
      "nth": 1,
      "suite": "gwbook",
      "note": "budget-set 401 back to .end()"
    },
    {
      "id": "A3_hint_dropped_export_get",
      "file": "services/gateway/src/server.js",
      "find": "return sendBookPossessionRequired\\(req, res, BOOK_POSSESSION_REQUIRED_BODY\\);",
      "flags": "",
      "replace": "return res.status(401).end();",
      "nth": 3,
      "suite": "gwbook",
      "note": "GET export 401 back to .end()"
    },
    {
      "id": "A4_hint_dropped_export_post",
