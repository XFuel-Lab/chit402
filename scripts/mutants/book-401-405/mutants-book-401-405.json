{
  "about": "Book 401 hint and POST-only book 405. Run with scripts/mutants/run-mutants.mjs.",
  "timeoutSec": 180,
  "suites": {
    "gwbook": {
      "cwd": "services/gateway",
      "argv": [
        "node",
        "--test",
        "--test-concurrency=1",
        "test/book-401-405.test.mjs",
        "test/agent-book.test.mjs",
        "test/agent-cap.test.mjs",
        "test/receipt-audit-path.test.mjs",
        "test/cors.test.mjs",
        "test/foreign-x402-ingest.test.mjs"
      ],
      "env": {
        "NODE_ENV": "test",
        "ISSUER_HISTORY_TEST_ROTATION": "true",
        "ISSUER_TEST_KEY": "1",
        "HUB_CATALOG_OFFLINE": "true"
      }
    }
  },
  "mutants": [
    {
      "id": "A1_hint_dropped_read",
      "file": "services/gateway/src/server.js",
