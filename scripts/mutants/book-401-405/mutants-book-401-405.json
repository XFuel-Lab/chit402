      "find": "if \\(result\\.status === 401\\) return sendBookPossessionRequired\\(req, res, BOOK_POSSESSION_REQUIRED_BODY\\);\\n        return res\\.status\\(result\\.status\\)\\.end\\(\\);",
      "flags": "",
      "replace": "return sendBookPossessionRequired(req, res, BOOK_POSSESSION_REQUIRED_BODY);",
      "nth": 1,
