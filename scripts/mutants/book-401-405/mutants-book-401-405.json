      "note": "method guard also matches OPTIONS"
    },
    {
      "id": "B10_405_after_404",
      "file": "services/gateway/src/server.js",
      "find": "app\\.use\\(bookPostOnlyMethodGuard\\);\\n\\n  // ── 404 fallback ────────────────────────────────────────────────────────\\n\\n  app\\.use\\(\\(_req, res\\) => \\{\\n    res\\.set\\('Cache-Control', 'private, no-store'\\);\\n    res\\.status\\(404\\)\\.json\\(\\{ error: 'not_found' \\}\\);\\n  \\}\\);",
      "flags": "",
      "replace": "// ── 404 fallback ────────────────────────────────────────────────────────\n\n  app.use((_req, res) => {\n    res.set('Cache-Control', 'private, no-store');\n    res.status(404).json({ error: 'not_found' });\n  });\n\n  app.use(bookPostOnlyMethodGuard);",
      "nth": 1,
      "suite": "gwbook",
      "note": "405 registered after the 404 fallback"
