      "nth": 1,
      "suite": "gwbook",
      "note": "401 body includes agent_id"
    },
    {
      "id": "A10_scope_creep_policy",
      "file": "services/gateway/src/server.js",
      "find": "// GET /v1/agents/:agent_id/book/policy — Get current policy\\n  app\\.get\\('/v1/agents/:agent_id/book/policy', privateNoStore\\(\\), \\(req, res\\) => \\{\\n    try \\{\\n      const claim = claimFromRequest\\(req\\);\\n      const session = claim\\.session;\\n      const proof = claim\\.proof;\\n      if \\(!session && !proof\\) \\{\\n        return res\\.status\\(401\\)\\.end\\(\\);",
      "flags": "",
      "replace": "// GET /v1/agents/:agent_id/book/policy — Get current policy\n  app.get('/v1/agents/:agent_id/book/policy', privateNoStore(), (req, res) => {\n    try {\n      const claim = claimFromRequest(req);\n      const session = claim.session;\n      const proof = claim.proof;\n      if (!session && !proof) {\n        return sendBookPossessionRequired(req, res, BOOK_POSSESSION_REQUIRED_BODY);",
      "nth": 1,
      "suite": "gwbook",
      "note": "policy GET 401 sends the hint"
    },
    {
      "id": "B1_405_swallows_post",
      "file": "services/gateway/src/server.js",
      "find": "if \\(req\\.method !== 'GET' && req\\.method !== 'HEAD'\\) return next\\(\\);\\n([\\s\\S]*?)app\\.get\\('/v1/agents/:agent_id/book', privateNoStore\\(\\), sendAgentBook\\);",
      "flags": "",
      "replace": "$1  app.use(bookPostOnlyMethodGuard);\n  app.get('/v1/agents/:agent_id/book', privateNoStore(), sendAgentBook);",
      "nth": 1,
      "suite": "gwbook",
      "note": "method-agnostic guard mounted before the book routes"
    },
    {
      "id": "B2_wrong_allow",
      "file": "services/gateway/src/server.js",
      "find": "res\\.set\\('Allow', 'POST'\\);",
      "flags": "",
      "replace": "res.set('Allow', 'GET, POST');",
      "nth": 1,
      "suite": "gwbook",
      "note": "Allow lists GET as well as POST"
    },
    {
      "id": "B3_405_covers_get_route",
      "file": "services/gateway/src/server.js",
      "find": "'/v1/agents/:agent_id/book/rotate',\\n\\]\\);",
      "flags": "",
      "replace": "'/v1/agents/:agent_id/book/rotate',\n  '/v1/agents/:agent_id/book/dispute',\n]);",
      "nth": 1,
      "suite": "gwbook",
      "note": "dispute added to BOOK_POST_ONLY_SUBROUTES"
    },
    {
      "id": "B4_405_catches_unknown",
      "file": "services/gateway/src/server.js",
      "find": "return BOOK_POST_ONLY_SUBROUTES\\.some\\(\\(pattern\\) => bookPostOnlyPatternMatches\\(pattern, path\\)\\);",
      "flags": "",
      "replace": "return bookPostOnlyPatternMatches('/v1/agents/:agent_id/book/*splat', path);",
      "nth": 1,
      "suite": "gwbook",
      "note": "matcher widened to a book splat"
    },
    {
      "id": "B5_405_drops_one",
      "file": "services/gateway/src/server.js",
      "find": "  '/v1/agents/:agent_id/book/inflow/correct',\\n",
      "flags": "",
      "replace": "",
      "nth": 1,
      "suite": "gwbook",
      "note": "inflow/correct removed from the constant"
    },
    {
      "id": "B6_405_status_404",
      "file": "services/gateway/src/server.js",
      "find": "res\\.set\\('Content-Type', 'application/json; charset=utf-8'\\);\\n    res\\.status\\(405\\);",
      "flags": "",
      "replace": "res.set('Content-Type', 'application/json; charset=utf-8');\n    res.status(404);",
      "nth": 1,
      "suite": "gwbook",
      "note": "405 handler sends 404"
    },
    {
      "id": "B7_405_body_changed",
      "file": "services/gateway/src/server.js",
      "find": "\\{\"error\":\"method_not_allowed\"\\}",
      "flags": "",
      "replace": "{\"error\":\"not_allowed\"}",
      "nth": 1,
      "suite": "gwbook",
      "note": "method_not_allowed renamed"
    },
    {
      "id": "B8_405_before_ratelimit",
      "file": "services/gateway/src/server.js",
      "find": "app\\.use\\('/v1/agents', rateLimit\\);",
      "flags": "",
      "replace": "app.use(bookPostOnlyMethodGuard);\n  app.use('/v1/agents', rateLimit);",
      "nth": 1,
      "suite": "gwbook",
      "note": "405 mounted before the /v1/agents rate limiter"
