{
  "about": "Home hero and Tier-2 price mutants. Offline. Kill means the web static suite fails.",
  "timeoutSec": 180,
  "suites": {
    "webstatic": {
      "cwd": "apps/web",
      "argv": [
        "node",
        "--test",
        "--test-concurrency=1",
        "test/prerender-replacer.test.mjs",
        "test/seo.test.mjs",
        "test/static-pages.test.mjs"
      ],
      "env": {}
    },
    "truthcopy": {
      "cwd": "apps/web",
      "argv": [
        "node",
        "--test",
        "--test-concurrency=1",
        "test/truth-copy.test.mjs"
      ],
      "env": {}
    }
  },
  "mutants": [
    {
      "id": "H1_old_h1_restored",
      "file": "apps/web/src/content/homeContent.mjs",
      "find": "Your agents spent money this week\\. On what, and with whom\\?",
      "flags": "",
      "replace": "Who paid which call — and you still hold it.",
      "nth": 1,
      "suite": "webstatic",
      "note": "locked h1 stays"
    },
    {
      "id": "H2_subhead_dropped_from_edge",
      "file": "apps/web/src/content/homeContent.mjs",
      "find": "paragraphs: \\[homeContent\\.subhead, homeContent\\.checkYourself\\]",
      "flags": "",
      "replace": "paragraphs: [homeContent.checkYourself]",
      "nth": 1,
      "suite": "webstatic",
      "note": "edge home block keeps the subhead"
    },
    {
      "id": "H3_chip_label_restored",
      "file": "apps/web/src/content/homeContent.mjs",
      "find": "pricingLabel: '\\$0\\.002 per receipt'",
      "flags": "",
      "replace": "pricingLabel: 'Standard receipt ' + '$' + '0.002 · routing cost + 1%'",
      "nth": 1,
      "suite": "webstatic",
      "note": "hero chip is only $0.002 per receipt"
    },
    {
      "id": "H4_products_chip_readded",
      "file": "apps/web/src/content/homeContent.mjs",
      "find": "\\{ href: homeContent\\.pricingHref, label: homeContent\\.pricingLabel \\},",
      "flags": "",
      "replace": "{ href: homeContent.pricingHref, label: homeContent.pricingLabel },\n          { href: '/products', label: 'Stamp · Private Desk · Attest' },",
      "nth": 1,
      "suite": "webstatic",
      "note": "hero does not show the products chip"
    },
    {
      "id": "H5_tier2_drops_currently_unavailable",
      "file": "apps/web/src/content/pricingContent.mjs",
      "find": "Currently unavailable ",
      "flags": "",
      "replace": "",
      "nth": 1,
      "suite": "webstatic",
      "note": "Tier-2 price stays marked currently unavailable"
    },
    {
      "id": "H6_tier2_price_removed",
      "file": "apps/web/src/content/pricingContent.mjs",
      "find": "\\+\\$0\\.10 ",
      "flags": "",
      "replace": "",
      "nth": 1,
      "suite": "webstatic",
      "note": "pricing states the Tier-2 price"
    },
    {
      "id": "H7_chithome_inlines_h1",
      "file": "apps/web/src/pages/ChitHome.tsx",
      "find": "<h1 style=\\{styles\\.heroTitle\\}>\\{homeContent\\.h1\\}</h1>",
      "flags": "",
      "replace": "<h1 style={styles.heroTitle}>Your agents spent money this week. On what, and with whom?</h1>",
      "nth": 1,
      "suite": "webstatic",
      "note": "ChitHome reads the shared h1 constant"
    },
    {
      "id": "H8_subhead_reworded",
      "file": "apps/web/src/content/homeContent.mjs",
      "find": "a link to its receipt",
      "flags": "",
      "replace": "a link you can open",
      "nth": 1,
      "suite": "webstatic",
      "note": "subhead stays on the locked wording"
    },
    {
      "id": "S2_pricing_render_drops_locked",
      "file": "apps/web/src/content/pricingContent.mjs",
      "find": "tier2Off,\\n        ' ',\\n        tier2\\.replace",
      "flags": "",
      "replace": "tier2.replace",
      "nth": 1,
      "suite": "webstatic",
      "note": "removing the locked sentence from the pricing render fails"
    },
    {
      "id": "S2_products_body_drops_locked",
      "file": "apps/web/src/pages/Products.tsx",
      "find": "\\{TIER2_OFF\\} \\{TIER2_LINE\\}",
      "flags": "",
      "replace": "{TIER2_LINE}",
      "nth": 1,
      "suite": "webstatic",
      "note": "removing the locked sentence from the products body fails"
    },
    {
      "id": "S3_subhead_billions",
      "file": "apps/web/src/content/homeContent.mjs",
      "find": "a link to its receipt",
      "flags": "",
      "replace": "Trusted by billions.",
      "nth": 1,
      "suite": "truthcopy",
      "note": "Trusted by billions. in the subhead fails"
    },
    {
      "id": "S3_home_stranger",
      "file": "apps/web/src/content/homeContent.mjs",
      "find": "a link to its receipt",
      "flags": "",
      "replace": "a link a stranger can check",
      "nth": 1,
      "suite": "truthcopy",
      "note": "stranger in homeContent.mjs fails"
    },
    {
      "id": "H9_second_h1_readded",
      "file": "middleware.ts",
      "find": "pathname\\.startsWith\\('/v1'\\) \\? `<h1>\\$\\{seo\\.h1\\}</h1>\\\\n      ` : ''",
      "flags": "",
      "replace": "`<h1>${seo.h1}</h1>\\n      <h1>Second heading</h1>\\n      `",
      "nth": 1,
      "suite": "webstatic",
      "note": "home noscript does not add a second h1"
    },
    {
      "id": "H10_old_home_title_restored",
      "file": "apps/web/src/content/homeContent.mjs",
      "find": "Chit402: receipts for what your agents spend",
      "flags": "",
      "replace": "Chit402 — treasury desk for agent spend",
      "nth": 1,
      "suite": "webstatic",
      "note": "home title stays off the old treasury-desk wording"
    },
    {
      "id": "H11_home_title_reworded",
      "file": "apps/web/src/content/homeContent.mjs",
      "find": "receipts for what your agents spend",
      "flags": "",
      "replace": "receipts for agent spend",
      "nth": 1,
      "suite": "webstatic",
      "note": "home title wording stays exact"
    },
    {
      "id": "H12_nojs_h1_hardcoded",
      "file": "apps/web/src/content/homeContent.mjs",
      "find": "h1: homeContent\\.h1",
      "flags": "",
      "replace": "h1: 'Your agents spent a different week. On what?'",
      "nth": 1,
      "suite": "webstatic",
      "note": "no-JS home h1 reads HOME_H1"
    }
  ]
}
