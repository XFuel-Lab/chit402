{
  "name": "DepositProof",
  "version": "1.0.0",
  "description": "Enhanced ZK-SNARK circuit for TFUEL deposit proofs with bounds checks and non-malleability",
  "date": "2026-01-06",
  "security": {
    "features": [
      "Range proofs to prevent field overflow",
      "Safe arithmetic to prevent integer overflow",
      "Merkle tree verification for transaction inclusion",
      "Identity commitments for non-malleability",
      "Nullifier generation for replay protection"
    ],
    "constraints": {
      "total": "~15000",
      "publicInputs": 5,
      "privateInputs": 27
    }
  },
  "publicInputs": [
    "vaultAddress",
    "netAmount",
    "blockNumber",
    "merkleRoot",
    "identityCommitment"
  ],
  "privateInputs": [
    "senderAddress",
    "grossAmount",
    "feeAmount",
    "blockHash",
    "blockTimestamp",
    "txHash",
    "txIndex",
    "merkleProof[16]",
    "merklePathIndices[16]",
    "identitySecret",
    "identityNullifier",
    "identityTrapdoor"
  ],
  "compatibility": {
    "circom": "^2.1.9",
    "snarkjs": "^0.7.0",
    "curve": "BN254",
    "provingSystem": "Groth16"
  },
  "ibcChannelCompatibility": {
    "channel": "channel-190",
    "chainId": "core-1",
    "protocol": "ICS-20",
    "verified": true
  }
}

