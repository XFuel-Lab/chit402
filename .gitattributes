# Shell scripts must use LF regardless of host OS. A CRLF shebang makes Linux
# look for `/bin/bash\r` and fail at exec ("no such file or directory"), which
# breaks container entrypoints (e.g. services/sp1-prover/watchdog.sh).
*.sh text eol=lf
docs/well-known/issuer-key.json text eol=lf
docs/well-known/issuer-key.sig text eol=lf
docs/well-known/issuer-key.ref.json text eol=lf
packages/cs2-core/vectors/*.json text eol=lf
packages/cs2-core/seal/node_modules/** text eol=lf
packages/cs2-core/seal/vendor/PINS.json text eol=lf
packages/cs2-core/VENDOR.md text eol=lf
packages/cs2-core/eip712/vectors/*.json text eol=lf
