{
  "name": "xfuel-protocol",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "cd xfuel-app && vite",
    "build": "cd xfuel-app && tsc -b && vite build",
    "preview": "cd xfuel-app && vite preview",
    "lint": "eslint . --max-warnings 5",
    "test": "npm test --prefix sdk/js",
    "test:watch": "npm run test:watch --prefix sdk/js",
    "test:e2e": "wait-on http://localhost:3000 && cypress open",
    "cypress:open": "wait-on http://localhost:3000 && cypress open",
    "test:e2e:headless": "wait-on http://localhost:3000 && cypress run",
    "test:e2e:cypress:aidepin": "cypress run --spec cypress/e2e/ai-depin-e2e.cy.ts",
    "test:contracts": "hardhat test",
    "test:contracts:all:hardhat": "node scripts/hardhat-test-all.cjs",
    "test:contracts:all": "npm run test:contracts:core:listener && npm run test:contracts:all:hardhat",
    "test:contracts:core:listener": "node --test core-layer/test/ai-listener.test.js",
    "test:contracts:core:solidity": "node scripts/hardhat-test-core.cjs",
    "test:contracts:core": "npm run test:contracts:core:listener && npm run test:contracts:core:solidity",
    "test:contracts:cosmos-yield": "hardhat test test/cosmos-yield/*.test.cjs",
    "test:contracts:circuits": "hardhat test circuits/*/test/*.test.cjs test/priority-circuits/*.test.cjs",
    "test:contracts:theta": "hardhat test test/phase1/ZKVerifierZkGPT.test.cjs test/phase1/ZKMLCircuitZkGPTIntegration.test.cjs test/phase1/ThetaInferenceCircuitZkGPTIntegration.test.cjs circuits/theta-inference/test/ThetaInferenceCircuit.test.cjs circuits/theta-inference/test/theta-inference-handler.test.cjs",
    "test:zkgpt-mock": "node zkgpt-prover/smoke-test.cjs",
    "test:zkgpt-e2e": "node zkgpt-prover/e2e-prover-test.cjs",
    "run:zkgpt-prover": "node zkgpt-prover/wrapper-template.cjs",
    "test:phase1": "npm run test:contracts:theta && npm run test:zkgpt-mock",
    "test:believer": "hardhat test believer/test/BelieverRound.test.cjs believer/test/AngelRound.test.cjs believer/test/AngelEscrow.test.cjs",
    "test:tokenomics": "node test/tokenomics/fee-analytics-tokenomics.test.cjs",
    "test:coverage": "hardhat coverage --solcoverjs .solcover.cjs --testfiles 'test/coverage-runner.js'",
    "typechain": "hardhat typechain",
    "gas:snapshot": "node scripts/gas-snapshot.cjs",
    "gas:check": "node scripts/gas-snapshot.cjs --check",
    "deploy:theta-testnet": "hardhat run scripts/deploy.cjs --network theta-testnet",
    "check-balance": "hardhat run scripts/check-balance.cjs --network theta-testnet",
    "verify:testnet": "node scripts/verify-deployment.cjs --manifest deploy/manifests/testnet-1772715928482.json",
    "verify:mainnet": "node scripts/verify-deployment.cjs --manifest deploy/manifests/mainnet-1771282254947.json --rpc https://eth-rpc-api.thetatoken.org/rpc",
    "health": "node backend/theta-bridge/src/server.js",
    "dev:backend": "node backend/theta-bridge/src/server.js",
    "dev:ibc": "ts-node --esm backend/ibc/index.ts",
    "dev:web": "cd xfuel-app && vite",
    "dev:mobile": "cd edgefarm-mobile && npm run start",
    "build:web": "cd xfuel-app && tsc -b && vite build",
    "build:ibc": "tsc backend/ibc/*.ts --outDir dist/ibc --module esnext --target es2020",
    "bridge:dev": "cd backend/theta-bridge && npm run dev",
    "bridge:start": "cd backend/theta-bridge && npm start",
    "bridge:pm2": "cd backend/theta-bridge && pm2 start ecosystem.config.cjs",
    "bridge:docker": "cd backend/theta-bridge && docker-compose up -d",
    "bridge:logs": "cd backend/theta-bridge && docker-compose logs -f theta-bridge",
    "bridge:stop": "cd backend/theta-bridge && docker-compose down",
    "extract-logos": "ts-node --esm scripts/extract-logos.ts",
    "extract-logo-bubble": "ts-node --esm scripts/extract-logo-bubble.ts",
    "extract-logo-simple": "ts-node --esm scripts/extract-logo-simple.ts",
    "extract-xf-logo": "ts-node --esm scripts/extract-xf-logo.ts",
    "generate-favicons": "ts-node --esm scripts/generate-favicons.ts",
    "eas:update:preview": "cd edgefarm-mobile && npx eas-cli update --branch preview --message \"Investor demo\"",
    "test:performance": "ts-node --esm scripts/test-performance.ts",
    "perf:monitor": "echo \"Performance monitoring enabled in dev mode. Check console for metrics.\"",
    "setup:theta-wallet": "node -e \"console.log('Run ./setup-theta-wallet.sh (Linux/Mac) or setup-theta-wallet.bat (Windows)')\"",
    "test:wallet": "jest --testPathPattern=walletConnect",
    "test:wallet:e2e": "cypress run --spec 'cypress/e2e/theta-wallet-qr.cy.ts'",
    "postinstall": "node scripts/patch-solcover.cjs",
    "sdk:build": "cd sdk/js && npm install && npm run build",
    "sdk:pack": "cd sdk/js && npm run build && npm pack"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1086.0",
    "@cosmjs/cosmwasm-stargate": "^0.33.1",
    "@cosmjs/proto-signing": "^0.33.1",
    "@cosmjs/stargate": "^0.33.1",
    "@keplr-wallet/types": "^0.12.306",
    "@thetalabs/theta-js": "^0.0.86",
    "@types/canvas-confetti": "^1.9.0",
    "@walletconnect/ethereum-provider": "^2.17.2",
    "@walletconnect/modal": "^2.7.0",
    "axios": "^1.13.6",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "ethers": "^6.16.0",
    "express": "^4.18.2",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "marked": "^17.0.1",
    "p-queue": "^7.4.1",
    "puppeteer": "^24.34.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.3",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^1.1.1",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-etherscan": "^3.1.8",
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.17",
    "@types/jest": "^29.5.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.16",
    "chai": "^4.3.10",
    "cypress": "^13.6.2",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.25",
    "hardhat": "^2.19.4",
    "hardhat-gas-reporter": "^2.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "node-fetch": "^2.7.0",
    "playwright": "^1.40.0",
    "postcss": "^8.4.32",
    "sharp": "^0.34.5",
    "solidity-coverage": "^0.8.17",
    "tailwindcss": "^3.3.6",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.1",
    "wait-on": "^7.2.0"
  }
}
