{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "xfuel.app" }],
      "destination": "https://www.chit402.com/:path*",
      "statusCode": 308
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.xfuel.app" }],
      "destination": "https://www.chit402.com/:path*",
      "statusCode": 308
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/xfuel-icon.svg",
      "headers": [{ "key": "Content-Type", "value": "image/svg+xml; charset=utf-8" }]
    },
    {
      "source": "/chit402-icon.svg",
      "headers": [{ "key": "Content-Type", "value": "image/svg+xml; charset=utf-8" }]
    },
    {
      "source": "/favicon.ico",
      "headers": [{ "key": "Content-Type", "value": "image/x-icon" }]
    },
    {
      "source": "/og-image.png",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    }
  ],
  "rewrites": [
    { "source": "/llms.txt", "destination": "/api/llms.txt" },
    { "source": "/robots.txt", "destination": "/api/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    { "source": "/xfuel-icon.svg", "destination": "/xfuel-icon.svg" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/og-image.png", "destination": "/og-image.png" },
    { "source": "/agent-shop", "destination": "/agent-shop/index.html" },
    { "source": "/book", "destination": "/book/index.html" },
    { "source": "/book-bot", "destination": "/book-bot/index.html" },
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/docs/chit-in-15-lines", "destination": "/docs/chit-in-15-lines/index.html" },
    { "source": "/docs/eliza", "destination": "/docs/eliza/index.html" },
    { "source": "/v1", "destination": "/v1/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
