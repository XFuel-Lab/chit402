# xfuel-app — copy to .env.local (gitignored). Vercel: set same keys under Project → Environment Variables.
# Build embeds these at `npm run build` time (see vite.config.ts).

# ── Theta testnet (365) — rehearsal before mainnet ─────────────────────────
# Use deploy/manifests from theta-testnet deploys. Switch all to 361 addresses for production.

# Minimum for /believers + /angels only:
VITE_BELIEVER_ROUND_ADDRESS=
VITE_ANGEL_ROUND_ADDRESS=

# Core protocol (Governance / Dashboard / Monitoring) — optional until those pages should be live
VITE_VERIFIER_ADDRESS=
VITE_SPLITTER_ADDRESS=
VITE_THETA_INFERENCE_ADDRESS=
# VITE_GOVERNANCE_ADDRESS=   — veXFGovernance; omit = Governance page shows demo until set

# UI-enforced minimum TFUEL (frontend gate — on-chain min is the true floor)
# VITE_BELIEVER_MIN_TFUEL=100
# VITE_ANGEL_MIN_TFUEL=10000

# AngelEscrow admin page (optional — only needed for /escrow-admin)
# VITE_ANGEL_ESCROW_ADDRESS=

# Backend (omit = localhost:3002 in bundle — fine for local dev only)
# VITE_API_URL=              — Monitoring: base URL for theta-ai/stats
# VITE_M2M_API_URL=          — Dashboard: M2M / bridge health

# Community page JSON (default /community-content.json if unset)
# VITE_COMMUNITY_CONTENT_URL=https://xfuel.app/community-content.json

# XFuel subchain RPC — optional; Dashboard block monitor only. NOT required for Believer/Angel (Theta 365/361 EVM).
# VITE_SUBCHAIN_TESTNET_RPC=
# VITE_SUBCHAIN_MAINNET_RPC=
# VITE_SUBCHAIN_CHAINID=365001
