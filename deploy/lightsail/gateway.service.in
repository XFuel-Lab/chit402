[Unit]
Description=Gateway API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<SERVICE_USER>
Group=<SERVICE_USER>
WorkingDirectory=<ENV_PATH>

# Load .env via bash so values that contain + / = are not mangled
# by systemd EnvironmentFile parsing.
ExecStart=/bin/bash -lc 'set -a; source ./.env; set +a; exec /usr/bin/node src/server.js'

# on-failure (not always): avoids fighting orphans on EADDRINUSE
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

TimeoutStopSec=20
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
