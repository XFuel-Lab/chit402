{
  "name": "xfuel-sdk",
  "version": "0.6.0",
  "description": "Chit402 SDK — USDC/x402 on Base, tiered receipts, SP1 proofs. Submit AI tasks, pay, prove, verify.",
  "main": "./index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./onchain": {
      "types": "./dist/onchain.d.ts",
      "import": "./dist/onchain.js",
      "require": "./dist/onchain.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "index.cjs",
    "index.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/XFuel-Lab/chit402/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/XFuel-Lab/chit402/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "example:demo": "tsx examples/flagship-demo.ts",
    "example:quickstart": "tsx examples/quickstart.ts",
    "example:openai": "tsx examples/openai-drop-in.ts",
    "example:pay": "tsx examples/pay-with-usdc.ts",
    "example:verify": "tsx examples/pay-prove-verify.ts",
    "example:a2a": "tsx examples/a2a-swarm.ts",
    "example:swarm": "tsx examples/swarm-coordinate.ts",
    "example:govern": "tsx examples/govern-vexf.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "chit402",
    "xfuel",
    "ai",
    "agents",
    "usdc",
    "x402",
    "base",
    "zk",
    "sp1",
    "m2m",
    "sdk",
    "depin",
    "bittensor",
    "akash"
  ],
  "author": "XFuel Lab",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/XFuel-Lab/chit402.git",
    "directory": "packages/sdk"
  },
  "dependencies": {
    "axios": "^1.19.0"
  },
  "peerDependencies": {
    "ethers": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "ethers": "^6.16.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  }
}
