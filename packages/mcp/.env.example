# xfuel-mcp / chit402-mcp — environment template
#
# All values are OPTIONAL. With none set, the server talks to Chit402's hosted
# public beta (https://api.chit402.com) using the shared demo key (chit402-demo).
# ─────────────────────────────────────────────────────────────────────────────

# ── Chit402 API (xfuel aliases accepted) ───────────────────────────────────
# Preferred public names:
CHIT402_API_URL=https://api.chit402.com
CHIT402_API_KEY=chit402-demo
# Shorter aliases:
# CHIT_API_URL=https://api.chit402.com
# CHIT_API_KEY=chit402-demo
# Legacy xfuel names (win when both xfuel + chit are set):
# XFUEL_API_URL=https://api.xfuel.app
# XFUEL_API_KEY=chit402-demo

# ── Transport ────────────────────────────────────────────────────────────────
XFUEL_MCP_TRANSPORT=stdio
XFUEL_MCP_PORT=3033
XFUEL_MCP_AUTH_TOKEN=

# ── verify_receipt / verify_proof on-chain checks (optional) ─────────────────
XFUEL_RPC_URL=
ZK_VERIFIER_ADDRESS=

# ── verify_model_commitment (optional; PoMA) ─────────────────────────────────
MODEL_REGISTRY_ADDRESS=

# ── get_validation_status (optional; ERC-8004) ───────────────────────────────
ERC8004_VALIDATION_REGISTRY=

# ── get_provider_stake (optional) ────────────────────────────────────────────
PROVIDER_STAKING_ADDRESS=
