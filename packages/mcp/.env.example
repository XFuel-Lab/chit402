# ─────────────────────────────────────────────────────────────────────────────
# xfuel-mcp — environment template
#
# All values are OPTIONAL. With none set, the server talks to XFuel's hosted
# testnet demo (https://api-testnet.xfuel.app) using the shared, rate-limited
# public demo key ("xfuel-demo") — so it works out of the box.
# ─────────────────────────────────────────────────────────────────────────────

# ── XFuel API ────────────────────────────────────────────────────────────────
# Where the MCP tools send requests. Defaults to the hosted testnet demo.
XFUEL_API_URL=https://api-testnet.xfuel.app
# API key sent as X-API-Key. Defaults to the public demo key. Bring your own for
# higher rate limits / production.
XFUEL_API_KEY=xfuel-demo

# ── Transport ────────────────────────────────────────────────────────────────
# stdio (default; for local clients like Claude Desktop / Cursor) or http.
# CLI flags --stdio / --http / --port override these.
XFUEL_MCP_TRANSPORT=stdio
XFUEL_MCP_PORT=3033
# Optional: require "Authorization: Bearer <token>" on the HTTP endpoint.
# Leave empty for an open endpoint (fine for local / trusted networks).
XFUEL_MCP_AUTH_TOKEN=

# ── verify_proof on-chain check (optional) ───────────────────────────────────
# Enables the optional nullifier replay read in the verify_proof tool.
XFUEL_RPC_URL=
ZK_VERIFIER_ADDRESS=

# ── verify_model_commitment (optional; PoMA) ─────────────────────────────────
# ModelRegistry address on Base (paired with XFUEL_RPC_URL). Enables the
# verify_model_commitment tool — checking a served model against its on-chain
# authenticity commitment (anti-downgrade for Verified Inference / Tier-3).
MODEL_REGISTRY_ADDRESS=

# ── get_validation_status (optional; ERC-8004) ───────────────────────────────
# ERC-8004 Validation Registry address (paired with XFUEL_RPC_URL). Enables the
# get_validation_status tool — reading on-chain agent-task validation verdicts.
ERC8004_VALIDATION_REGISTRY=

# ── get_provider_stake (optional; Verified Inference Phase 4) ─────────────────
# ProviderStaking address (paired with XFUEL_RPC_URL). Enables the
# get_provider_stake tool — reading a provider's stake + slash history.
PROVIDER_STAKING_ADDRESS=

# ── pay_with_usdc (optional; MOVES FUNDS) ────────────────────────────────────
# Set a funded payer private key to enable the pay_with_usdc tool. Left empty,
# the tool is inert and every other tool still works zero-config. The USDC
# network is taken from the server's x402 challenge (Base / Base Sepolia).
# SECURITY: this key can spend USDC — use a low-balance wallet, env/secret store
# only (never a CLI flag or shell history), on a trusted host.
XFUEL_PAYER_PRIVATE_KEY=
