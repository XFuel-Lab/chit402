{
  "name": "xfuel-mcp",
  "version": "0.4.1",
  "mcpName": "io.github.XFuel-Lab/xfuel-mcp",
  "description": "Official MCP server for Chit402 — chat completions (unmetered /v1), paid task submit, quotes, and settlement proofs. Runs over stdio or streamable HTTP.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "xfuel-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example",
    "server.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test src/__tests__/config.test.ts src/__tests__/format.test.ts src/__tests__/receipt-fields.test.ts src/__tests__/tools.test.ts",
    "smoke": "node --import tsx scripts/smoke.mjs",
    "prepublishOnly": "npm run build && npm test",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "chit402",
    "xfuel",
    "mcp",
    "model-context-protocol",
    "ai",
    "depin",
    "zk",
    "sp1",
    "inference",
    "agent-tools"
  ],
  "author": "XFuel Lab",
  "license": "Apache-2.0",
  "homepage": "https://github.com/XFuel-Lab/chit402/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/XFuel-Lab/chit402/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/XFuel-Lab/chit402.git",
    "directory": "packages/mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xfuel/verify": "^0.1.0",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "xfuel-sdk": "^0.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
