{
  "name": "@xfuel/verify",
  "version": "0.4.11",
  "description": "Alias of chit402-verify. The xfuel-verify bin stays.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "bin": {
    "xfuel-verify": "cli.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "cli.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node test.mjs"
  },
  "keywords": [
    "chit402",
    "verify",
    "receipt",
    "x402",
    "usdc",
    "base",
    "offline",
    "zk"
  ],
  "author": "XFuel Lab",
  "license": "Apache-2.0",
  "homepage": "https://chit402.com",
  "bugs": {
    "url": "https://github.com/XFuel-Lab/chit402/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XFuel-Lab/chit402.git",
    "directory": "packages/aliases/chit402-verify"
  },
  "dependencies": {
    "chit402-verify": "0.4.11"
  }
}
