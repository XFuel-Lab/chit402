{
  "name": "chit402-sdk",
  "version": "0.6.0",
  "description": "Chit402 SDK — OpenAI-compatible client for receipted AI inference. USDC via x402 on Base.",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./onchain": {
      "types": "./onchain.d.ts",
      "import": "./onchain.mjs",
      "require": "./onchain.cjs"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "onchain.cjs",
    "onchain.mjs",
    "onchain.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://chit402.com",
  "bugs": {
    "url": "https://github.com/XFuel-Lab/chit402/issues"
  },
  "scripts": {
    "test": "node test.mjs"
  },
  "keywords": [
    "chit402",
    "ai",
    "agents",
    "usdc",
    "x402",
    "base",
    "sdk",
    "openai",
    "receipts"
  ],
  "author": "XFuel Lab",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/XFuel-Lab/chit402.git",
    "directory": "packages/aliases/chit402-sdk"
  },
  "dependencies": {
    "xfuel-sdk": "^0.6.0"
  },
  "peerDependencies": {
    "ethers": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    }
  }
}
