      "replace": "export const SLOT_BYTES = ENC_BYTES + DK_BYTES;",
      "note": "slot drops the AEAD tag width"
    },
    {
      "id": "S08_header_second_byte",
      "file": "packages/cs2-core/seal/index.js",
      "find": "if (line[0] !== HEADER_BYTE_0 || line[1] !== HEADER_BYTE_1) return fail('bad_header');",
