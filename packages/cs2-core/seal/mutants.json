    {
      "id": "H11_nonce_endian",
      "file": "packages/cs2-core/seal/hpke.js",
      "find": "for (let i = out.length - 1; i >= 0; i -= 1) {",
      "replace": "for (let i = 0; i < out.length; i += 1) {",
