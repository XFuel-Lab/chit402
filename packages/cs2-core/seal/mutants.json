{
  "suite": {
    "cwd": ".",
    "argv": ["node", "--test", "--test-concurrency=1", "packages/cs2-core/seal/seal.test.mjs"]
  },
  "mutants": [
    {
      "id": "S01_dk_label",
      "file": "packages/cs2-core/seal/index.js",
