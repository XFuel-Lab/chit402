    {
      "id": "S02_info_domain",
      "file": "packages/cs2-core/seal/index.js",
      "find": "const INFO = ascii('chit402-seal-v1');",
      "replace": "const INFO = ascii('chit402-seal-v2');",
      "note": "HPKE info domain changed"
    },
    {
      "id": "S03_leaf_label",
      "file": "packages/cs2-core/seal/index.js",
      "find": "const LEAF_LABEL = ascii('line');",
