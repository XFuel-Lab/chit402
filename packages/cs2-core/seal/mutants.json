      "replace": "if (line.length > LINE_BYTES) return fail('bad_length');",
      "note": "a short buffer is no longer a length error"
    },
    {
      "id": "S11_line_length_long",
      "file": "packages/cs2-core/seal/index.js",
      "find": "if (line.length !== LINE_BYTES) return fail('bad_length');",
      "replace": "if (line.length < LINE_BYTES) return fail('bad_length');",
      "note": "a long buffer is no longer a length error"
