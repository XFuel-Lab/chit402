    {
      "id": "L28_leaf_prefix",
      "file": "packages/cs2-core/line/index.mjs",
      "find": "const STATE_LEAF_PREFIX = 0x00;",
      "replace": "const STATE_LEAF_PREFIX = 0x01;",
