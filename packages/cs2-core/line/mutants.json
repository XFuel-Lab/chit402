      "replace": "for (let i = USED_BYTES; i < LINE_BYTES - 1; i += 1) {\n    if (line[i] !== 0) return fail('bad_padding');",
      "note": "last pad byte is not checked"
    },
    {
      "id": "L05_pad_skip_first",
