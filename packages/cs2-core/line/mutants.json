{
  "suite": {
    "cwd": ".",
    "argv": ["node", "--test", "--test-concurrency=1", "packages/cs2-core/line/line.test.mjs"]
  },
  "mutants": [
    {
      "id": "L01_header_type",
      "file": "packages/cs2-core/line/index.mjs",
      "find": "export const HEADER_BYTE_1 = 0x32;",
      "replace": "export const HEADER_BYTE_1 = 0x33;",
      "note": "second header byte is no longer ASCII 2"
    },
    {
      "id": "L02_header_ignores_type",
      "file": "packages/cs2-core/line/index.mjs",
      "find": "if (line[0] !== HEADER_BYTE_0 || line[1] !== HEADER_BYTE_1) return fail('bad_header');",
      "replace": "if (line[0] !== HEADER_BYTE_0) return fail('bad_header');",
      "note": "decode checks only the first header byte"
    },
    {
      "id": "L03_pad_check_off",
      "file": "packages/cs2-core/line/index.mjs",
      "find": "if (line[i] !== 0) return fail('bad_padding');",
      "replace": "if (false && line[i] !== 0) return fail('bad_padding');",
      "note": "non-zero pad is accepted"
    },
