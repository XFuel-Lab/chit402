      "replace": "for (let i = USED_BYTES; i < LINE_BYTES; i += 1) line[i] = 1;",
      "note": "encode writes non-zero padding"
    },
    {
      "id": "L07_empty_string_not_missing",
      "file": "packages/cs2-core/line/index.mjs",
      "find": "if (value === undefined || value === null || value === '') return fail('missing_block_hash');",
      "replace": "if (value === undefined || value === null) return fail('missing_block_hash');",
      "note": "empty blockHash is not missing"
    },
    {
      "id": "L08_null_not_missing",
      "file": "packages/cs2-core/line/index.mjs",
      "find": "if (value === undefined || value === null || value === '') return fail('missing_block_hash');",
      "replace": "if (value === undefined || value === '') return fail('missing_block_hash');",
      "note": "null blockHash is not missing"
    },
    {
      "id": "L09_omitted_not_missing",
      "file": "packages/cs2-core/line/index.mjs",
      "find": "if (value === undefined || value === null || value === '') return fail('missing_block_hash');",
      "replace": "if (value === null || value === '') return fail('missing_block_hash');",
      "note": "omitted blockHash is not missing"
    },
    {
