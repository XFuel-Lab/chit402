    {
      "id": "L22_kind_05",
      "file": "packages/cs2-core/line/index.mjs",
      "find": "[KIND_EPOCH, 0],",
      "replace": "[KIND_EPOCH, 0],\n  [0x05, 20],",
      "note": "kind 0x05 is accepted"
    },
    {
      "id": "L23_epoch_len",
      "file": "packages/cs2-core/line/index.mjs",
