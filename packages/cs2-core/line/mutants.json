    },
    {
      "id": "L19_little_endian",
      "file": "packages/cs2-core/line/index.mjs",
      "find": "for (let i = width - 1; i >= 0; i -= 1) {",
      "replace": "for (let i = 0; i < width; i += 1) {",
      "note": "multi-byte integers are little-endian"
    },
