# XFuel AI DePIN Dashboard — Environment Variables
# Copy this file to .env and fill in your values.

# M2M API base URL (backend server.js)
REACT_APP_API_URL=http://localhost:3002

# API key for authentication (must match M2M_API_KEYS on backend)
REACT_APP_API_KEY=

# Polling interval in milliseconds (default: 5000)
REACT_APP_POLL_INTERVAL=5000

# WebSocket URL for real-time updates (optional, falls back to polling)
REACT_APP_WS_URL=
