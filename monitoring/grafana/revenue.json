{
  "dashboard": {
    "id": null,
    "uid": "xfuel-revenue",
    "title": "XFuel Revenue & Fee Streams",
    "tags": ["xfuel", "revenue", "fees", "tokenomics"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "30s",
    "time": { "from": "now-24h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "Total Simulated Monthly Fees",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "xfuel_sim_total_fees",
            "legendFormat": "Total Fees",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": { "fixedColor": "green", "mode": "fixed" }
          }
        }
      },
      {
        "id": 2,
        "title": "Monthly Volume",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
        "targets": [
          {
            "expr": "xfuel_sim_monthly_volume",
            "legendFormat": "Volume",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": { "fixedColor": "cyan", "mode": "fixed" }
          }
        }
      },
      {
        "id": 3,
        "title": "Monthly BBB Burns",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "xfuel_sim_monthly_burns",
            "legendFormat": "XF Burned",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": { "fixedColor": "red", "mode": "fixed" }
          }
        }
      },
      {
        "id": 4,
        "title": "Live Fees Collected",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
        "targets": [
          {
            "expr": "xfuel_ai_fees_collected",
            "legendFormat": "Collected",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "fixedColor": "yellow", "mode": "fixed" }
          }
        }
      },
      {
        "id": 5,
        "title": "Revenue Split (30/30/25/15)",
        "description": "Simulated revenue allocation: BBB Buyback & Burn (30%), LP Reinvestment (30%), veXF Stakers (25%), Treasury (15%)",
        "type": "piechart",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
        "targets": [
          { "expr": "xfuel_sim_split_bbb", "legendFormat": "BBB Buyback & Burn (30%)", "refId": "A" },
          { "expr": "xfuel_sim_split_lp", "legendFormat": "LP Reinvestment (30%)", "refId": "B" },
          { "expr": "xfuel_sim_split_vexf", "legendFormat": "veXF Stakers (25%)", "refId": "C" },
          { "expr": "xfuel_sim_split_treasury", "legendFormat": "Treasury (15%)", "refId": "D" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "currencyUSD" },
          "overrides": [
            { "matcher": { "id": "byName", "options": "BBB Buyback & Burn (30%)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#ff5252", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "LP Reinvestment (30%)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#69f0ae", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "veXF Stakers (25%)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#00e5ff", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Treasury (15%)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#b388ff", "mode": "fixed" } }] }
          ]
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
          "pieType": "donut"
        }
      },
      {
        "id": 6,
        "title": "Fee Streams Breakdown",
        "description": "Fees by source: AI Task (0.5-1%), A2A Relay (0.1%), Data Attestation, Bridge (0.5%)",
        "type": "barchart",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
        "targets": [
          { "expr": "xfuel_sim_fees_ai_task", "legendFormat": "AI Task Fees", "refId": "A", "instant": true },
          { "expr": "xfuel_sim_fees_a2a_relay", "legendFormat": "A2A Relay Fees", "refId": "B", "instant": true },
          { "expr": "xfuel_sim_fees_data_attestation", "legendFormat": "Data Attestation", "refId": "C", "instant": true },
          { "expr": "xfuel_sim_fees_bridge", "legendFormat": "Bridge Fees", "refId": "D", "instant": true }
        ],
        "fieldConfig": {
          "defaults": { "unit": "currencyUSD" },
          "overrides": [
            { "matcher": { "id": "byName", "options": "AI Task Fees" }, "properties": [{ "id": "color", "value": { "fixedColor": "#00e5ff", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "A2A Relay Fees" }, "properties": [{ "id": "color", "value": { "fixedColor": "#b388ff", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Data Attestation" }, "properties": [{ "id": "color", "value": { "fixedColor": "#69f0ae", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Bridge Fees" }, "properties": [{ "id": "color", "value": { "fixedColor": "#ffab40", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 7,
        "title": "Volume Mix (AI / Data / Settlements)",
        "type": "piechart",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
        "targets": [
          { "expr": "xfuel_sim_volume_ai_tasks", "legendFormat": "AI Tasks (60%)", "refId": "A" },
          { "expr": "xfuel_sim_volume_data_comms", "legendFormat": "Data & Comms (25%)", "refId": "B" },
          { "expr": "xfuel_sim_volume_settlements", "legendFormat": "Settlements (15%)", "refId": "C" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "currencyUSD" },
          "overrides": [
            { "matcher": { "id": "byName", "options": "AI Tasks (60%)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#00e5ff", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Data & Comms (25%)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#69f0ae", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Settlements (15%)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#ffab40", "mode": "fixed" } }] }
          ]
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
          "pieType": "donut"
        }
      },
      {
        "id": 8,
        "title": "Revenue Split Over Time",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
        "targets": [
          { "expr": "xfuel_sim_split_bbb", "legendFormat": "BBB (30%)", "refId": "A" },
          { "expr": "xfuel_sim_split_lp", "legendFormat": "LP (30%)", "refId": "B" },
          { "expr": "xfuel_sim_split_vexf", "legendFormat": "veXF (25%)", "refId": "C" },
          { "expr": "xfuel_sim_split_treasury", "legendFormat": "Treasury (15%)", "refId": "D" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20,
              "stacking": { "mode": "normal" },
              "gradientMode": "scheme"
            }
          },
          "overrides": [
            { "matcher": { "id": "byName", "options": "BBB (30%)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#ff5252", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "LP (30%)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#69f0ae", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "veXF (25%)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#00e5ff", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Treasury (15%)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#b388ff", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 9,
        "title": "FeeCollector On-Chain State",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
        "targets": [
          { "expr": "xfuel_fee_collector_accumulated", "legendFormat": "Accumulated", "refId": "A" },
          { "expr": "xfuel_fee_collector_total_burned", "legendFormat": "Total Burned", "refId": "B" }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": { "lineWidth": 2, "fillOpacity": 10 }
          },
          "overrides": [
            { "matcher": { "id": "byName", "options": "Accumulated" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Total Burned" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 10,
        "title": "Burn Rate",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
        "targets": [
          {
            "expr": "rate(xfuel_fee_collector_total_burned[1h]) * 3600",
            "legendFormat": "burned/hour",
            "refId": "A"
          },
          {
            "expr": "rate(xfuel_fee_collector_burns_count[1h]) * 3600",
            "legendFormat": "ops/hour",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": { "lineWidth": 2, "fillOpacity": 15 }
          }
        }
      }
    ]
  },
  "overwrite": true
}
