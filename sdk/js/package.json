{
  "name": "xfuel-sdk",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript SDK for the XFuel Protocol M2M API — submit AI tasks, retrieve ZK proofs, send A2A messages.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "xfuel",
    "ai",
    "depin",
    "zk",
    "sp1",
    "m2m",
    "sdk",
    "theta",
    "bittensor",
    "akash"
  ],
  "author": "XFuel Protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/XFuel-Lab/xfuel-protocol.git",
    "directory": "sdk/js"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.2.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  }
}
