# ============================================================
# SP1 ZK PROVER - Succinct Network Mode (SP1 v6)
# No GPU needed - uses SP1's distributed proving network
# ============================================================

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    libssl-dev \
    pkg-config \
    git \
    ca-certificates \
    protobuf-compiler \
    golang-go \
    && rm -rf /var/lib/apt/lists/*

# Rust stable (SP1 v6 minimum: 1.91)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# Install SP1 CLI v6 from release tarball
RUN mkdir -p /tmp/sp1-cli && \
    curl -L "https://github.com/succinctlabs/sp1/releases/download/v6.0.2/cargo_prove_v6.0.2_linux_amd64.tar.gz" \
    -o /tmp/sp1-cli/cargo-prove.tar.gz && \
    tar -xzf /tmp/sp1-cli/cargo-prove.tar.gz -C /tmp/sp1-cli/ && \
    mv /tmp/sp1-cli/cargo-prove /root/.cargo/bin/cargo-prove && \
    chmod +x /root/.cargo/bin/cargo-prove && \
    rm -rf /tmp/sp1-cli

# Install SP1 RISC-V toolchain
RUN cargo prove install-toolchain

# Verify
RUN cargo prove --version && rustup toolchain list

WORKDIR /app

# NOTE: build context is the REPO ROOT (not sp1-prover/), because the workspace
# Cargo.toml references ../core-layer/sp1-hooks. Build with:
#   docker build --platform linux/amd64 -f services/sp1-prover/Dockerfile.network -t xfuel-sp1-prover:network .
COPY services/sp1-prover/Cargo.toml /app/Cargo.toml
COPY services/sp1-prover/rust-toolchain.toml /app/rust-toolchain.toml
COPY services/sp1-prover/program /app/program
COPY services/sp1-prover/host /app/host
# Vendor the out-of-tree workspace member in-tree. Cargo requires every workspace
# member to live below the workspace root, so copy core-layer/sp1-hooks under /app
# and rewrite the ../core-layer/sp1-hooks path in the copied Cargo.toml only
# (source tree is untouched).
COPY core-layer/sp1-hooks /app/sp1-hooks
RUN sed -i 's|\.\./core-layer/sp1-hooks|sp1-hooks|g' /app/Cargo.toml

# Build host (build.rs compiles guest automatically)
# Use x86-64-v3 (AVX2) for portability across EdgeCloud nodes
RUN cd /app/host && \
    RUSTFLAGS="-C target-cpu=x86-64-v3" cargo build --release

COPY services/sp1-prover/test-data /app/test-data
COPY services/sp1-prover/watchdog.sh /app/watchdog.sh
# Normalize line endings (a CRLF shebang makes the kernel look for `/bin/bash\r`,
# which fails with "exec: no such file or directory") then make executable.
RUN sed -i 's/\r$//' /app/watchdog.sh && chmod +x /app/watchdog.sh

EXPOSE 80

ENV SP1_PROVER=network
ENV RUST_LOG=info
# SP1_PRIVATE_KEY must be set at runtime via EdgeCloud env vars

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:80/healthz || exit 1

CMD ["/app/watchdog.sh"]
