# Minimal image with one file (start-ping.cjs). If smoke 1/1 but this 0/20, the COPY or file is the issue.
# Build from repo root: docker build -f zkgpt-prover/Dockerfile.theta-diagnostic -t xfuel/xfuel-zkgpt-prover:theta-diagnostic .
FROM node:20-slim
WORKDIR /app
COPY services/zkgpt-prover/start-ping.cjs ./
EXPOSE 81
ENTRYPOINT []
CMD ["/usr/local/bin/node", "/app/start-ping.cjs"]
