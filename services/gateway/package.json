{
  "name": "xfuel-gateway",
  "version": "2.0.0",
  "description": "XFuel agent gateway — routing, x402/USDC on Base, proving, receipts",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "postinstall": "npm install --omit=dev --prefix ../../packages/circuit-runtime/theta-inference",
    "start": "node src/index.js",
    "dev": "cross-env NODE_ENV=development node src/index.js",
    "ai-listener": "cross-env AI_LISTENER_ENABLED=true node src/index.js",
    "m2m-server": "cross-env AI_LISTENER_ENABLED=true node src/server.js",
    "deps:theta-inference": "npm install --omit=dev --prefix ../../packages/circuit-runtime/theta-inference",
    "fee-analytics": "node src/fee-analytics.js",
    "split:emit": "node scripts/emit-split.js",
    "fee-analytics:watch": "node src/fee-analytics.js --watch --interval 60",
    "fee-analytics:prometheus": "node src/fee-analytics.js --format prometheus --watch --port 9100",
    "fee-analytics:simulate": "node src/fee-analytics.js --simulate --volume 2000000 --ai-share 0.6",
    "benchmark:cuda": "node scripts/run-benchmark.mjs cuda",
    "benchmark:zan": "node scripts/run-benchmark.mjs zan",
    "benchmark:compare": "node ../../scripts/compare-benchmarks.cjs bench/edgecloud-cuda.summary.json bench/powerzebra.summary.json --out bench/comparison.md",
    "benchmark:mock:cuda": "node scripts/mock-prover-server.js --port 8091 --prove-ms 520 --jitter 40",
    "benchmark:mock:zan": "node scripts/mock-prover-server.js --port 8092 --prove-ms 105 --jitter 12",
    "test": "node --test test/webhooks.test.mjs test/x402-adapter.test.mjs test/x402-facilitator.test.mjs test/x402-server.test.mjs test/receipt.test.mjs test/provider-float.test.mjs test/hub-catalog.test.mjs test/x402-discovery.test.mjs test/task-store.test.mjs test/telemetry.test.mjs test/stats-route.test.mjs test/prover-config.test.mjs test/prover-zan-auth.test.mjs test/payment-binding.test.mjs test/openai-gateway.test.mjs test/demo-mode.test.mjs test/revenue-split.test.mjs test/erc8004.test.mjs test/tier-policy.test.mjs test/tee-attestation.test.mjs test/spotcheck.test.mjs test/cdp-jwt.test.mjs test/private-spend.test.mjs"
  },
  "keywords": [
    "xfuel",
    "x402",
    "usdc",
    "base",
    "zk-proof",
    "ai-agents",
    "gateway"
  ],
  "author": "XFuelLab",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^6.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
