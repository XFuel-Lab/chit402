# XFuel gateway — Base Sepolia USDC e2e (ADR 0001).
# Copy to .env and fill the 0x... placeholders. NEVER commit real keys.
# The payer's private key is NOT set here — it stays on the payer machine and is
# passed to the SDK example as XFUEL_PAYER_PK (EIP-3009 signing, key never leaves you).

# ── x402 / USDC on Base Sepolia ──────────────────────────────────────────────
X402_ENABLED=true
X402_DEFAULT_RAIL=usdc
X402_FACILITATOR_PROVIDER=x402      # standard public x402 facilitator (Base Sepolia, no key)
# X402_FACILITATOR_URL=             # leave blank → adapter's public Base Sepolia reference
X402_NETWORK=base-sepolia
X402_ASSET=USDC
X402_PAY_TO=0xYOUR_SPLIT_ADDRESS    # the deployed Splits v2 Split — fees land here (Stage A output)
X402_USDC_PRICE_DEFAULT=10000       # $0.01 (USDC, 6dp)

# ── Revenue split (Base) — consumed by `npm run split:emit` to build the Split ──
REVENUE_NETWORK=base-sepolia
REVENUE_SPLIT_OWNER=0xYOUR_SAFE     # governance Safe — owns + can edit the Split
REVENUE_TREASURY_ADDRESS=0xYOUR_SAFE
REVENUE_TREASURY_BPS=6000
REVENUE_BUYBACK_ADDRESS=0xYOUR_MM_WALLET
REVENUE_BUYBACK_BPS=4000
REVENUE_STAKERS_BPS=0               # testnet: omit stakers (0 bps ⇒ no address needed)
# SPLITS_FACTORY_ADDRESS=           # only if deploying via calldata (Splits UI knows it per chain)
REVENUE_SPLIT_ADDRESS=             # set to the deployed Split after Stage A (mirror into X402_PAY_TO)

# ── Public receipt / verify_url links ────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:3002

# ── Tier-1 SP1 proof home on Base Sepolia (ADR 0002) ─────────────────────────
# Deploy: npx hardhat run deploy/base-verifier.cjs --network base-sepolia
# ZK_VERIFIER_ADDRESS=0x...
# VERIFIER_CHAIN_ID=84532
# BASE_RPC_URL=https://sepolia.base.org
# SP1_PROVER_URL=
# Leave prover/verifier unset for signed-receipt-only e2e.
