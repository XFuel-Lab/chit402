          "type": "address",
          "internalType": "address"
        }
      ]
    },
    {
      "type": "error",
      "name": "RevokedAtBeforeStart",
      "inputs": [
        {
          "name": "revokedAt",
          "type": "uint64",
          "internalType": "uint64"
        },
        {
          "name": "earliest",
          "type": "uint64",
          "internalType": "uint64"
        }
      ]
    },
    {
      "type": "error",
      "name": "RevokedAtInFuture",
      "inputs": [
        {
          "name": "revokedAt",
          "type": "uint64",
          "internalType": "uint64"
        }
      ]
    },
    {
      "type": "error",
      "name": "RevokedAtZero",
      "inputs": []
    },
    {
      "type": "error",
      "name": "SeqOverflow",
      "inputs": []
    },
    {
      "type": "error",
      "name": "SupersedeSelf",
      "inputs": []
    },
    {
      "type": "error",
      "name": "UnknownOp",
      "inputs": [
        {
          "name": "kind",
          "type": "uint8",
          "internalType": "uint8"
        }
      ]
    },
    {
      "type": "error",
      "name": "ZeroController",
      "inputs": []
    },
    {
      "type": "error",
      "name": "ZeroKid",
      "inputs": []
    },
    {
      "type": "error",
      "name": "ZeroNextRegistry",
      "inputs": []
    },
    {
      "type": "error",
      "name": "ZeroUniverseId",
      "inputs": []
    }
  ],
  "keys": {
    "getter": "keys(bytes32)",
    "returns": [
      {
        "name": "status",
        "type": "uint8",
        "notes": "0 none, 1 standby, 2 active, 3 retired, 4 revoked"
      },
      {
        "name": "wasActive",
        "type": "bool",
        "notes": "true once the key has been active, including after revoke"
      },
      {
        "name": "notBefore",
        "type": "uint64"
      },
      {
        "name": "notAfter",
        "type": "uint64",
        "notes": "0 means open"
      },
      {
        "name": "revokedAt",
        "type": "uint64",
        "notes": "0 means not revoked"
      },
      {
        "name": "activatedAt",
        "type": "uint64",
        "notes": "0 until PROMOTE; genesis sets this to notBefore. Validity starts at max(notBefore, activatedAt)."
      }
    ],
    "slots": {
      "perKey": 2,
      "base": "keccak256(abi.encode(kid, uint256(4)))",
      "slot0": "status | wasActive | notBefore | notAfter | revokedAt",
      "slot1": "activatedAt in the low 64 bits"
    }
  },
  "rootHash": {
    "domains": {
      "GENESIS_DOMAIN": "keccak256(\"chit.issuerRoot.genesis.v1\")",
      "COMMIT_DOMAIN": "keccak256(\"chit.issuerRoot.commit.v1\")"
    },
    "genesis": {
      "when": "constructor, stored at rootSeq 0",
      "preimage": "keccak256(abi.encode(GENESIS_DOMAIN, chainId, registry, controller, genesisKid, genesisNotBefore, activatedAt, uint64(block.number)))",
      "activatedAt": "genesisNotBefore",
      "events": [
        "KeyActivated(kid, activatedAt, 0)",
        "GenesisSeeded(controller, kid, notBefore, activatedAt, blockNumber, rootHash)"
      ]
    },
    "commit": {
      "when": "commit(), rootSeq increments from the previous value",
      "preimage": "keccak256(abi.encode(COMMIT_DOMAIN, prevRootHash, rootSeq, chainId, registry, uint64(block.number), ops, freezeArgs, histVersion, histSnapshot))",
      "blockNumber": "uint64(block.number) of the commit. This is frozenBlock for every freeze in the transaction. A reorg that replays the calldata in another block changes rootHash.",
      "blockhash": "Not stored. blockhash(block.number) is zero inside the transaction. Verifiers read the hash of the RootCommitted or Frozen log's block after it is sealed.",
      "events": [
        "one key or freeze event per argument, then RootCommitted(rootSeq, rootHash, historyVersion, historySnapshot, blockNumber)"
      ]
    },
    "op": {
      "type": "(uint8 kind, bytes32 kid, uint64 timestamp, uint8 reasonCode)",
      "kinds": {
        "1": "ADD_STANDBY",
        "2": "PROMOTE",
        "3": "RETIRE",
        "4": "REVOKE"
      },
      "reasonCode": {
        "1": "compromise",
        "2": "superseded",
        "3": "lost",
        "255": "other"
      }
    },
    "freezeArg": "(bytes32 universeId, bytes32 universeHash, uint64 enumeratedCount)"
  }
}
