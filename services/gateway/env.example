# Theta RPC Configuration (comma-separated; MultiRpcProvider fails over left→right)
THETA_RPC_URLS=https://eth-rpc-api.thetatoken.org/rpc,https://theta-eth-rpc.thetatoken.org/rpc,https://theta-bridge-rpc.thetatoken.org/rpc

# Preferred/primary Theta RPC. When set, this endpoint is prepended as the PRIMARY
# provider and the THETA_RPC_URLS above are retained as fallback (deduped), so the
# primary is never a single point of failure. Leave blank to use the public list only.
#
# NOTE (verified 2026-07): ZAN Node Service does NOT support Theta in its shared
# catalog — `.../node/v1/theta/...` returns `-32600 "ecosystem not supported"`.
# ZAN is a Theta *validator*, not a Theta RPC provider. Only set this to a ZAN
# endpoint if you procure a ZAN *dedicated* Theta node. For any endpoint, confirm
# the Theta ETH-RPC adaptor (chainId 361/365) first:
#   node scripts/verify-rpc.cjs "<url>"   (or EXPECT_CHAIN_ID=361 to assert)
# Do NOT commit the real key; this file is an example only.
ZAN_THETA_RPC_URL=

# Webhook delivery (global PUT /webhook + per-task callback_url)
# Default HMAC secret used to sign deliveries when a per-hook secret is not set.
WEBHOOK_SECRET=
# How often (ms) the dispatcher scans for settled tasks to deliver. Default 2000.
WEBHOOK_POLL_INTERVAL_MS=2000

# Route /task-request inference through the full 6-tier DePIN ComputeRouter
# (EdgeCloud → RapidAPI → MCP → Akash → Render → Bedrock) instead of the single
# THETA_EDGE_URL path. Default ON (provider-agnostic). The full router executes
# real inference, so it requires raw `input` on the task-request (not just
# input_hash); hash-only requests fall back to the default path automatically.
# Opt out with =false. See docs/design/M2M_ROUTING_UNIFICATION.md.
M2M_USE_FULL_ROUTER=true

# ── AkashML (first-class DePIN chat provider) ─────────────────────────────────
# OpenAI-compatible managed inference on Akash Network (api.akashml.com).
# Chat-only; image/audio stay on Theta. Catalog ids: akash/<nativeId>
# (e.g. akash/zai-org/GLM-5.2). Float id: akash-network.
# Free credits: https://akashml.com — see docs/FOUNDER_ACTIONS.md
#
# MUST be an AkashML *inference* key — it starts with `akml-`. Akash ships a second,
# unrelated credential and its docs call that one AKASH_API_KEY:
#   akml-…   inference   api.akashml.com            Bearer      billed per token
#   ac.sk.…  Console     console-api.akash.network  x-api-key   billed per LEASE
# A Console key here is rejected (401) and AkashML routing stays off — the gateway
# logs a warning rather than silently serving mock. Console/SDL leases are not a
# supported XFuel compute path; see docs/providers/README.md.
AKASHML_API_KEY=
# AKASHML_BASE_URL=https://api.akashml.com/v1
# AKASHML_DEFAULT_MODEL=zai-org/GLM-5.2

# Cosmos (Osmosis/Akash) inbound IBC intent WebSocket listeners. Off by default —
# settlement home is Base (ADR 0002); these sockets are unrelated to AkashML compute.
COSMOS_LISTENERS_ENABLED=false

# ── Generic OpenAI-compatible provider (the provider-agnostic tier) ───────────
# Point at ANY OpenAI-shaped endpoint — swapping providers is an env change, not
# a code change. Sits after the DePIN tiers as the primary reliable route.
#   OpenAI:    https://api.openai.com/v1        (model e.g. gpt-4o-mini)
#   Groq:      https://api.groq.com/openai/v1   (model e.g. openai/gpt-oss-120b — Llama 3.x shut down 2026-08-16)
#   Together:  https://api.together.xyz/v1
#   Fireworks: https://api.fireworks.ai/inference/v1
#   vLLM:      http://<host>:8000/v1            (self-hosted / Akash)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Label surfaced in receipts / logs (e.g. groq, together, openai).
OPENAI_COMPAT_NAME=openai-compatible

# Confidential / TEE-class OpenAI-compatible endpoint (Phala-class). Opt-in.
# When set, router prefers this tier before plain OPENAI_COMPAT for content privacy.
CONFIDENTIAL_PROVIDER_BASE_URL=
CONFIDENTIAL_PROVIDER_API_KEY=
CONFIDENTIAL_PROVIDER_MODEL=
CONFIDENTIAL_PROVIDER_NAME=confidential

# Claude (Anthropic) — reliable centralized LLM backstop appended AFTER the
# generic tier. LLM only. Set the key to enable the tier.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_VERSION=2023-06-01
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── ZK proving cost gate (Tier 1) ────────────────────────────────────────────
# Tasks always settle + return a signed receipt (Tier 0). The expensive SP1
# settlement proof is optional and gated here so a public/live demo doesn't burn
# prover budget. PROVER_ENABLED=false → proving OFF except for allow-listed keys.
# PROVER_ALLOW_KEYS (CSV) → when non-empty, ONLY these keys may prove. Typical
# live-demo config: PROVER_ENABLED=false + PROVER_ALLOW_KEYS=<partner keys>, with
# the ECS prover scaled to 0 (see deploy/ecs/README.md) so it also costs nothing.
PROVER_ENABLED=true
PROVER_ALLOW_KEYS=

# ZAN x402 agent micropayments (see docs/X402_ADAPTER.md + docs/MAINNET_X402_CHECKLIST.md)
X402_ENABLED=false
X402_FACILITATOR_PROVIDER=x402
# base-sepolia → public https://x402.org/facilitator (no key)
# base → defaults to CDP https://api.cdp.coinbase.com/platform/v2/x402
X402_NETWORK=base-sepolia
X402_FACILITATOR_URL=
X402_FACILITATOR_API_KEY=
X402_PAY_TO=
X402_ASSET=USDC
X402_DEFAULT_RAIL=usdc
X402_FALLBACK_TFUEL=false
# CDP Secret API Key (required for Base mainnet facilitator JWT auth)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Legacy ZAN facilitator (only if X402_FACILITATOR_PROVIDER=zan)
ZAN_X402_GATEWAY_URL=
ZAN_X402_API_KEY=
# Phase 2: bind payment_ref into the SP1 proof (attests payment + computation).
# Default off; full in-proof attestation needs the SP1 guest v2 rebuild (new vKey).
X402_PROOF_BINDING=false

# ── Task pricing (USDC smallest units, 6dp) — see docs/PRICING_STRATEGY.md ────
# Tasks are METERED against a rate card: prompt tokens + the max_tokens ceiling.
# A flat price cannot serve both a 750-token ping and a 68,000-token agent call.
# Floor a metered quote can never go below. Settlement itself costs money, so a
# sub-floor task nets negative however cheap its tokens were. $0.01.
X402_USDC_PRICE_DEFAULT=10000
# X402_USDC_FLOOR=10000          # explicit floor; defaults to the line above
# Retail rate card, base units per 1,000,000 tokens. Keys match a model id or a
# prefix of one (longest match wins), plus "default". This is OUR price, not a
# markup on COGS — per-task cost falls ~5-10x a year and a cost-plus price would
# deflate with it. Defaults: {"default":{"in":300000,"out":900000}} ($0.30/$0.90
# per million), which puts a median agent call near the $0.02 x402 market median.
# X402_USDC_RATE_CARD={"default":{"in":300000,"out":900000},"akash":{"in":250000,"out":750000}}
# Rows here override the built-in ones in pricing.js, which exist only to stop a
# known-dear model being sold at the cheap default rate. AkashML spans $0.037/M to
# $1.40/M input, so one row cannot cover the catalogue: GLM-5.2 at the default rate
# lost $0.075 on every median agent call, and it is what xfuel/auto resolves to.
# A key matches with or without the hub prefix, so zai-org/GLM-5.2 also prices
# akash/zai-org/GLM-5.2. Check margins with scripts/dev/_margin_check.mjs.
# Hand-set flat price for specific models; overrides the card entirely.
# X402_USDC_PRICES={"llama-3-70b":"90000"}

# ── Cost-plus pricing (ADR 0009) ─────────────────────────────────────────────
# Replaces the rate card above with: max(floor, measured COGS + a stated fee).
# OFF by default — switching pricing models is a commercial decision, not a
# deploy. On a median agent call this prices at $0.1034 against the card's
# $0.195, a ~47% cut, and it needs no per-model rows at all.
# The reason to prefer it is verifiability: the receipt already signs
# provider_cogs.actual, so a buyer can recompute the whole bill from the receipt
# instead of trusting a price list. No competitor attests COGS.
# The trade-off it accepts: provider cost falls ~5-10x a year and a percentage of
# it deflates too, so this bets token volume grows faster than unit price falls.
# ONLY SAFE WITH VI_TIER2_MIN_COGS SET — see that variable. The gateway logs an
# error on startup if this is on without it (checkPricingConfig in pricing.js).
X402_COST_PLUS=true
# Platform fee on measured provider cost, in basis points. 1000 = 10%.
# Covers the signed receipt and network-pooled spot-check. It does NOT cover a
# Tier-2 SP1 proof: those cost a fixed ~$0.050 per Succinct request, 5.3x this fee
# on a median call, and are unbatchable for AI tasks. See docs/KNOWN_ISSUES.md.
# X402_PLATFORM_FEE_BPS=1000
# Flat charge for an opt-in Tier-2 SP1 settlement proof. Default 80000 ($0.08).
# Flat because the cost is flat — a Succinct request is 0.341064 PROVE regardless
# of circuit size, so a percentage cannot track it. $0.08 is 1.6x the measured
# ~$0.050; the headroom is FX, not margin: proof cost is denominated in PROVE at
# its all-time low, and this breaks even up to about PROVE $0.235.
# Added on top of the inference price and never absorbed by the floor.
# X402_TIER2_PROOF_UNITS=80000
# Charge for /v1/chat/completions. OFF by default: a plain OpenAI SDK cannot
# satisfy a 402, so turning this on breaks any client that does not speak x402.
# /v1 is the busiest surface, so metering /task-request alone earns nothing.
X402_METER_V1=false
# Keys that skip payment. The demo key (M2M_DEMO_API_KEY) is always exempt.
X402_METER_V1_EXEMPT_KEYS=
# Daily ceiling, in USD of *provider cost*, on what one caller may consume through
# the unmetered door. Receipts are free by policy (ADR 0006); the compute behind
# them is not, and a request-rate limit cannot tell a $0.001 ping from a $0.10
# agent call. Past the ceiling /v1 returns 402 free_tier_exhausted until UTC
# midnight. Keyed on the API-key hash — so the demo key is ONE bucket for the whole
# public internet, making this the cap on public exposure too. Held in memory: a
# restart forgives the day. 0 disables enforcement (COGS is still measured).
FREE_TIER_DAILY_COGS_USD=1
# Network-wide ceiling across EVERY free caller, same units. The per-key ceiling
# above is a budget *per key*, and keys are free to mint, so on its own total
# subsidy is unbounded: N keys is N ceilings. A request must clear both. Past this
# one /v1 returns 402 free_tier_capacity — a distinct code, because the caller has
# done nothing wrong and a metered key is the fix. This is the number to look at
# before advertising a free tier or running a campaign. 0 disables enforcement.
FREE_TIER_DAILY_COGS_TOTAL_USD=50

# ── Provider health ──────────────────────────────────────────────────────────
# Which models are actually serving. Theta publishes live worker counts in the
# catalogue poll, so its half is free and always on. AkashML publishes no
# capacity, health or status field at all, and it serves all live inference —
# so on the hub that matters, health comes from watching real calls (always on,
# costs nothing) plus this optional prober.
#
# PROVIDER_HEALTH_PROBE makes a synthetic 1-token call per Akash chat model on a
# timer. It costs real money (~$0.00002 a probe, so pennies a month) and issues
# requests nobody asked for, which is why it is off by default. It buys the two
# things watching real traffic cannot: noticing an outage before a customer
# does, and noticing recovery on a model nobody is currently calling.
# PROVIDER_HEALTH_PROBE=true
# PROVIDER_HEALTH_INTERVAL_MS=300000
# Consecutive failures before a model is routed around. One failure is noise.
# PROVIDER_HEALTH_FAIL_THRESHOLD=3
# Failures older than this stop counting, so a blip cannot delist a model
# permanently when no traffic arrives to prove it recovered.
# PROVIDER_HEALTH_STALE_MS=1800000
# Rolling settlement (ADR 0008). LIVE — founder accepted 2026-08-16.
# /task-request: serve first, collect the measured cost-plus bill
# (provider COGS × 1.10, $0.01 floor) on the caller's next request.
# You pay for the last call; /task-quote is a forecast of the next one.
# Last call before a caller leaves is never paid (one call per payer). Pending
# charges survive restart when TASK_STORE_PERSIST is on (default).
# /v1 stays free (ADR 0006). Rollback: set false and restart.
X402_ROLLING_SETTLEMENT=true
# Most we will front on a single unpaid call, in USD of the ceiling quote. A first
# request quoting above this is sent down the ordinary prepay path instead, so a
# fresh key cannot get one very large job for free. 0 disables the guard.
X402_ROLLING_MAX_UNSETTLED_USD=1
# Optional override for the payer ledger directory (default: sibling of TASK_STORE_DIR).
# PAYERS_LEDGER_DIR=
# Fee sink (Safe / Splits); falls back to X402_PAY_TO
REVENUE_SPLIT_ADDRESS=
REVENUE_NETWORK=base-sepolia

# Verified Inference (Tier-3). Optional HMAC signing of public receipts (PBR — tamper-evidence
# over the payment-bound tuple). Off by default → receipt JSON is unchanged. Set a strong secret
# to enable; verify client-side with the SDK `verifyReceiptSignature(receipt, secret)`.
RECEIPT_SIGNING_SECRET=

# Private Spend v0 — vendor-blind mode (docs/PRIVATE_SPEND_THESIS.md, docs/FOUNDER_ACTIONS.md)
# Buyer pays XFuel; providers see gateway-pooled credentials. Gateway-trusted (not prompt privacy).
PRIVATE_SPEND_ENABLED=false
# When Private Spend is on, avoid logging prompt/input bodies (default true if unset while enabled).
PRIVATE_SPEND_MINIMIZE_LOGS=true

# Auditor selective disclosure — optional JSON policy for ?format=auditor
# AUDITOR_POLICY_JSON={"max_fee_bps":100,"allowed_rails":["usdc","tfuel"],"private_spend_ok":true}
AUDITOR_POLICY_JSON=
# On-chain PoMA model-authenticity registry (contracts/core/ModelRegistry.sol). Enables the
# gateway to stamp route.model_commitment and the MCP verify_model_commitment/get_verified_quote
# tools to read it. Deploy: npx hardhat run deploy/model-registry.cjs --network base-sepolia
MODEL_REGISTRY_ADDRESS=
# Static PoMA commitments served by this node (JSON map slug → {commitment, version}) OR a path
# to a JSON file. Used when the registry is not queried at runtime.
MODEL_COMMITMENTS=

# ── Verified Inference tier engine (Phase 4) ─────────────────────────────────
# Off by default → receipts behave as before (no verified_inference block). When enabled, the
# gateway prices trust to value-at-risk and stamps the selected tier + honest attestation /
# spot-check summaries on the receipt. See docs/VERIFIED_INFERENCE_TIERS.md.
VERIFIED_INFERENCE_ENABLED=false
VI_TIER2_MIN_USDC=10000          # ≥ this gross value (USDC smallest unit) → settlement floor
VI_TIER3_MIN_USDC=1000000        # ≥ this → inference (Tier-3) floor
# COGS-denominated thresholds (ADR 0009). When set AND the task carries measured
# COGS, these REPLACE the two amount thresholds above. Unset by default.
# Set them before enabling X402_COST_PLUS. VI_TIER2_MIN_USDC is 10000 — the same
# value as the price floor — so on the amount basis nearly every paid call sits at
# the settlement floor. A Tier-2 proof costs a fixed ~$0.050 per Succinct request
# (measured 2026-08-14) against a 10% fee of $0.0094 on a median call, so that
# combination loses money on every call.
# Solvent threshold: COGS × feeRate ≥ K × ($0.050 / batchSize).
#   batch 10, K=4 → 200000 ($0.20)    batch 1, K=4 → 2000000 ($2.00)
# AI-task proofs cannot be batched (ai-listener passes urgent=true; the prover host
# only handles ai_task in its Single branch), so 2000000 is the operative value
# until Guest v2 ships a new ELF + vKey. See docs/KNOWN_ISSUES.md.
# At $2.00 almost no call reaches the threshold, which is the intent: Tier-2 is
# opt-in and charged (X402_TIER2_PROOF_UNITS) rather than bundled, until batching
# exists. Lower this to 200000 ($0.20) once Guest v2 lands.
VI_TIER2_MIN_COGS=2000000
# VI_TIER3_MIN_COGS=
VI_DEFAULT_MECHANISM=tee         # tee | zk-spotcheck | zk-full
VI_SETTLEMENT_AVAILABLE=true
VI_TEE_ENABLED=false
VI_SPOTCHECK_ENABLED=false
VI_ZKFULL_ENABLED=false
# TEE attestation policy. VI_TEE_VENDORS/SIGNERS/MEASUREMENTS are comma-separated. The 'dev'
# vendor uses a real secp256k1 signature (SOFTWARE trust) until a hardware attestor is wired.
VI_TEE_VENDORS=dev
VI_TEE_SIGNERS=                   # allowed attestor addresses (0x…) for the dev attestor
VI_TEE_MEASUREMENTS=             # allowed MRENCLAVE/measurement hashes (0x…)
VI_TEE_REQUIRE_MODEL_ROOT=false  # require attestation.model_root == task PoMA commitment
# Spot-check sampling (T3b). rate in basis points (2000 = 20%); seed is a per-epoch beacon.
VI_SPOTCHECK_RATE_BPS=0
VI_SPOTCHECK_SEED=
# ProviderStaking (T3b economics). Deploy: npx hardhat run deploy/provider-staking.cjs --network base-sepolia
PROVIDER_STAKING_ADDRESS=

# On-chain read addresses (for xfuel-sdk/onchain helpers; see deploy/manifests/)
ZK_VERIFIER_ADDRESS=
A2A_CIRCUIT_ADDRESS=
VE_GOVERNANCE_ADDRESS=

# Contract Addresses
# TODO: Replace with your actual deployed VaultFactory address
VAULT_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
SUBVAULT_ABI_PATH=./abis/SubVault.json
VAULT_FACTORY_ABI_PATH=./abis/VaultFactory.json

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Relayer Configuration (for refunds)
RELAYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
RELAYER_GAS_LIMIT=100000
RELAYER_MAX_FEE_PER_GAS=100000000000

# Expiry Configuration
EXPIRY_MINUTES=30

# ZK Proof Configuration (SP1 zkVM - Production)
# Legacy Groth16 circuit files exist for historical reference only
# Production uses SP1 zkVM prover (see sp1-program/ directory)
# ZK_CIRCUIT_WASM=./circuits/circuit.wasm
# ZK_CIRCUIT_ZKEY=./circuits/circuit_final.zkey
ZK_VERIFICATION_KEY=./circuits/verification_key.json

# SP1 Prover Configuration (Production - Phase B+)
# Update this to your deployed SP1 ECS endpoint or use latest from deployment
SP1_PROVER_URL=http://3.83.140.122:8080
SP1_PROVER_TIMEOUT=120000
SP1_PROVER_RETRIES=3
SP1_PROVER_FALLBACK=false

# Prover backend selector: cuda (default) | zan
# - cuda: Theta EdgeCloud CUDA GPU (SP1_PROVER_URL primary, SP1_FALLBACK_URL fallback)
# - zan:  ZAN PowerZebra endpoint (ZAN_PROVER_URL primary). The CUDA endpoint above is
#         kept as an AUTOMATIC fallback, so enabling ZAN is safe/reversible.
# ZAN must speak the same wire protocol (/prove, /prove/binary, /health, /metrics).
SP1_PROVER=cuda
ZAN_PROVER_URL=
ZAN_PROVER_API_KEY=
ZAN_PROVER_API_KEY_HEADER=x-api-key

# Phase 2 payment binding — set on the PROVER HOST (not this backend file unless you
# co-locate). When true, the SP1 host selects v2 public values for AI tasks that carry
# payment_commitment (requires rebuilt guest ELF + new programVKey). Default off.
# SP1_PUBLIC_VALUES_V2=false

# SP1 Batching Configuration (Production - Phase B: 11.6x speedup, 90% cost reduction)
SP1_BATCHING_ENABLED=true
SP1_BATCH_SIZE=10
SP1_BATCH_TIMEOUT_MS=10000
SP1_MIN_BATCH_SIZE=5

# Persistence Configuration (Phase 3)
PERSISTENCE_RPC_URL=https://rpc.persistence.one
PERSISTENCE_WS_URL=wss://rpc.persistence.one/websocket
# TODO: Replace with your actual deployed Persistence minter contract address (persistence1...)
PERSISTENCE_MINTER_CONTRACT=
PERSISTENCE_CHAIN_ID=core-1
PERSISTENCE_BURN_EVENT_TOPIC=burn_ibcTFUEL
PERSISTENCE_POLL_INTERVAL_MS=10000

# Reverse-Burn Loop Configuration
# 30% of ibcUSDC yields unwrapped to TFUEL and routed to RevenueSplitter
YIELD_UNWRAP_PERCENTAGE=30
# 70% reinvested for LP growth
YIELD_REINVEST_PERCENTAGE=70
# RevenueSplitter contract address (receives unwrapped TFUEL)
# TODO: Replace with your actual deployed RevenueSplitter address
REVENUE_SPLITTER_ADDRESS=0x0000000000000000000000000000000000000000
# Swap router address (for ibcUSDC -> TFUEL swap)
# TODO: Replace with your actual swap router address
SWAP_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
# Minimum yield amount to process (avoid dust, 1 USDC = 1000000)
MIN_YIELD_AMOUNT=1000000

# Service Configuration
PORT=3001
LOG_LEVEL=info
NODE_ENV=production

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=5000
RPC_TIMEOUT_MS=30000

# Block Confirmation Requirements
REQUIRED_CONFIRMATIONS=3
BLOCK_POLL_INTERVAL_MS=5000

