# Theta RPC Configuration (comma-separated; MultiRpcProvider fails over left→right)
THETA_RPC_URLS=https://eth-rpc-api.thetatoken.org/rpc,https://theta-eth-rpc.thetatoken.org/rpc,https://theta-bridge-rpc.thetatoken.org/rpc

# Preferred/primary Theta RPC. When set, this endpoint is prepended as the PRIMARY
# provider and the THETA_RPC_URLS above are retained as fallback (deduped), so the
# primary is never a single point of failure. Leave blank to use the public list only.
#
# NOTE (verified 2026-07): ZAN Node Service does NOT support Theta in its shared
# catalog — `.../node/v1/theta/...` returns `-32600 "ecosystem not supported"`.
# ZAN is a Theta *validator*, not a Theta RPC provider. Only set this to a ZAN
# endpoint if you procure a ZAN *dedicated* Theta node. For any endpoint, confirm
# the Theta ETH-RPC adaptor (chainId 361/365) first:
#   node scripts/verify-rpc.cjs "<url>"   (or EXPECT_CHAIN_ID=361 to assert)
# Do NOT commit the real key; this file is an example only.
ZAN_THETA_RPC_URL=

# Webhook delivery (global PUT /webhook + per-task callback_url)
# Default HMAC secret used to sign deliveries when a per-hook secret is not set.
WEBHOOK_SECRET=
# How often (ms) the dispatcher scans for settled tasks to deliver. Default 2000.
WEBHOOK_POLL_INTERVAL_MS=2000

# Route /task-request inference through the full 6-tier DePIN ComputeRouter
# (EdgeCloud → RapidAPI → MCP → Akash → Render → Bedrock) instead of the single
# THETA_EDGE_URL path. Default ON (provider-agnostic). The full router executes
# real inference, so it requires raw `input` on the task-request (not just
# input_hash); hash-only requests fall back to the default path automatically.
# Opt out with =false. See docs/design/M2M_ROUTING_UNIFICATION.md.
M2M_USE_FULL_ROUTER=true

# ── Generic OpenAI-compatible provider (the provider-agnostic tier) ───────────
# Point at ANY OpenAI-shaped endpoint — swapping providers is an env change, not
# a code change. Sits after the DePIN tiers as the primary reliable route.
#   OpenAI:    https://api.openai.com/v1        (model e.g. gpt-4o-mini)
#   Groq:      https://api.groq.com/openai/v1   (model e.g. llama-3.3-70b-versatile)
#   Together:  https://api.together.xyz/v1
#   Fireworks: https://api.fireworks.ai/inference/v1
#   vLLM:      http://<host>:8000/v1            (self-hosted / Akash)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Label surfaced in receipts / logs (e.g. groq, together, openai).
OPENAI_COMPAT_NAME=openai-compatible

# Claude (Anthropic) — reliable centralized LLM backstop appended AFTER the
# generic tier. LLM only. Set the key to enable the tier.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_VERSION=2023-06-01
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── ZK proving cost gate (Tier 1) ────────────────────────────────────────────
# Tasks always settle + return a signed receipt (Tier 0). The expensive SP1
# settlement proof is optional and gated here so a public/live demo doesn't burn
# prover budget. PROVER_ENABLED=false → proving OFF except for allow-listed keys.
# PROVER_ALLOW_KEYS (CSV) → when non-empty, ONLY these keys may prove. Typical
# live-demo config: PROVER_ENABLED=false + PROVER_ALLOW_KEYS=<partner keys>, with
# the ECS prover scaled to 0 (see deploy/ecs/README.md) so it also costs nothing.
PROVER_ENABLED=true
PROVER_ALLOW_KEYS=

# ZAN x402 agent micropayments (PROTOTYPE — see docs/X402_ADAPTER.md)
X402_ENABLED=false
ZAN_X402_GATEWAY_URL=
ZAN_X402_API_KEY=
X402_PAY_TO=
X402_NETWORK=base
X402_ASSET=USDC
# Phase 2: bind payment_ref into the SP1 proof (attests payment + computation).
# Default off; full in-proof attestation needs the SP1 guest v2 rebuild (new vKey).
X402_PROOF_BINDING=false

# Verified Inference (Tier-3). Optional HMAC signing of public receipts (PBR — tamper-evidence
# over the payment-bound tuple). Off by default → receipt JSON is unchanged. Set a strong secret
# to enable; verify client-side with the SDK `verifyReceiptSignature(receipt, secret)`.
RECEIPT_SIGNING_SECRET=
# On-chain PoMA model-authenticity registry (contracts/core/ModelRegistry.sol). Enables the
# gateway to stamp route.model_commitment and the MCP verify_model_commitment/get_verified_quote
# tools to read it. Deploy: npx hardhat run deploy/model-registry.cjs --network base-sepolia
MODEL_REGISTRY_ADDRESS=
# Static PoMA commitments served by this node (JSON map slug → {commitment, version}) OR a path
# to a JSON file. Used when the registry is not queried at runtime.
MODEL_COMMITMENTS=

# ── Verified Inference tier engine (Phase 4) ─────────────────────────────────
# Off by default → receipts behave as before (no verified_inference block). When enabled, the
# gateway prices trust to value-at-risk and stamps the selected tier + honest attestation /
# spot-check summaries on the receipt. See docs/VERIFIED_INFERENCE_TIERS.md.
VERIFIED_INFERENCE_ENABLED=false
VI_TIER2_MIN_USDC=10000          # ≥ this gross value (USDC smallest unit) → settlement floor
VI_TIER3_MIN_USDC=1000000        # ≥ this → inference (Tier-3) floor
VI_DEFAULT_MECHANISM=tee         # tee | zk-spotcheck | zk-full
VI_SETTLEMENT_AVAILABLE=true
VI_TEE_ENABLED=false
VI_SPOTCHECK_ENABLED=false
VI_ZKFULL_ENABLED=false
# TEE attestation policy. VI_TEE_VENDORS/SIGNERS/MEASUREMENTS are comma-separated. The 'dev'
# vendor uses a real secp256k1 signature (SOFTWARE trust) until a hardware attestor is wired.
VI_TEE_VENDORS=dev
VI_TEE_SIGNERS=                   # allowed attestor addresses (0x…) for the dev attestor
VI_TEE_MEASUREMENTS=             # allowed MRENCLAVE/measurement hashes (0x…)
VI_TEE_REQUIRE_MODEL_ROOT=false  # require attestation.model_root == task PoMA commitment
# Spot-check sampling (T3b). rate in basis points (2000 = 20%); seed is a per-epoch beacon.
VI_SPOTCHECK_RATE_BPS=0
VI_SPOTCHECK_SEED=
# ProviderStaking (T3b economics). Deploy: npx hardhat run deploy/provider-staking.cjs --network base-sepolia
PROVIDER_STAKING_ADDRESS=

# On-chain read addresses (for xfuel-sdk/onchain helpers; see deploy/manifests/)
ZK_VERIFIER_ADDRESS=
A2A_CIRCUIT_ADDRESS=
VE_GOVERNANCE_ADDRESS=

# Contract Addresses
# TODO: Replace with your actual deployed VaultFactory address
VAULT_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
SUBVAULT_ABI_PATH=./abis/SubVault.json
VAULT_FACTORY_ABI_PATH=./abis/VaultFactory.json

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Relayer Configuration (for refunds)
RELAYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
RELAYER_GAS_LIMIT=100000
RELAYER_MAX_FEE_PER_GAS=100000000000

# Expiry Configuration
EXPIRY_MINUTES=30

# ZK Proof Configuration (SP1 zkVM - Production)
# Legacy Groth16 circuit files exist for historical reference only
# Production uses SP1 zkVM prover (see sp1-program/ directory)
# ZK_CIRCUIT_WASM=./circuits/circuit.wasm
# ZK_CIRCUIT_ZKEY=./circuits/circuit_final.zkey
ZK_VERIFICATION_KEY=./circuits/verification_key.json

# SP1 Prover Configuration (Production - Phase B+)
# Update this to your deployed SP1 ECS endpoint or use latest from deployment
SP1_PROVER_URL=http://3.83.140.122:8080
SP1_PROVER_TIMEOUT=120000
SP1_PROVER_RETRIES=3
SP1_PROVER_FALLBACK=false

# Prover backend selector: cuda (default) | zan
# - cuda: Theta EdgeCloud CUDA GPU (SP1_PROVER_URL primary, SP1_FALLBACK_URL fallback)
# - zan:  ZAN PowerZebra endpoint (ZAN_PROVER_URL primary). The CUDA endpoint above is
#         kept as an AUTOMATIC fallback, so enabling ZAN is safe/reversible.
# ZAN must speak the same wire protocol (/prove, /prove/binary, /health, /metrics).
SP1_PROVER=cuda
ZAN_PROVER_URL=
ZAN_PROVER_API_KEY=
ZAN_PROVER_API_KEY_HEADER=x-api-key

# Phase 2 payment binding — set on the PROVER HOST (not this backend file unless you
# co-locate). When true, the SP1 host selects v2 public values for AI tasks that carry
# payment_commitment (requires rebuilt guest ELF + new programVKey). Default off.
# SP1_PUBLIC_VALUES_V2=false

# SP1 Batching Configuration (Production - Phase B: 11.6x speedup, 90% cost reduction)
SP1_BATCHING_ENABLED=true
SP1_BATCH_SIZE=10
SP1_BATCH_TIMEOUT_MS=10000
SP1_MIN_BATCH_SIZE=5

# Persistence Configuration (Phase 3)
PERSISTENCE_RPC_URL=https://rpc.persistence.one
PERSISTENCE_WS_URL=wss://rpc.persistence.one/websocket
# TODO: Replace with your actual deployed Persistence minter contract address (persistence1...)
PERSISTENCE_MINTER_CONTRACT=
PERSISTENCE_CHAIN_ID=core-1
PERSISTENCE_BURN_EVENT_TOPIC=burn_ibcTFUEL
PERSISTENCE_POLL_INTERVAL_MS=10000

# Reverse-Burn Loop Configuration
# 30% of ibcUSDC yields unwrapped to TFUEL and routed to RevenueSplitter
YIELD_UNWRAP_PERCENTAGE=30
# 70% reinvested for LP growth
YIELD_REINVEST_PERCENTAGE=70
# RevenueSplitter contract address (receives unwrapped TFUEL)
# TODO: Replace with your actual deployed RevenueSplitter address
REVENUE_SPLITTER_ADDRESS=0x0000000000000000000000000000000000000000
# Swap router address (for ibcUSDC -> TFUEL swap)
# TODO: Replace with your actual swap router address
SWAP_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
# Minimum yield amount to process (avoid dust, 1 USDC = 1000000)
MIN_YIELD_AMOUNT=1000000

# Service Configuration
PORT=3001
LOG_LEVEL=info
NODE_ENV=production

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=5000
RPC_TIMEOUT_MS=30000

# Block Confirmation Requirements
REQUIRED_CONFIRMATIONS=3
BLOCK_POLL_INTERVAL_MS=5000

