# ===============================
# DOCKER DEPLOYMENT CONFIGURATION
# ===============================
# This is the example file - copy to .env.docker and fill in your values



# Persistence Network
PERSISTENCE_RPC=https://rpc.core.persistence.one:443
PERSISTENCE_CHAIN_ID=core-1
PERSISTENCE_GAS_PRICES=0.025uxprt

# IBC Configuration
IBC_CHANNEL=channel-190
IBC_TIMEOUT=600

# Theta Mainnet (already deployed)
THETA_RPC=https://rpc.thetatoken.org/rpc
THETA_CHAIN_ID=361
VAULT_FACTORY_ADDRESS=0xB0a26600074dADC69186632a1B8dFd7c3146Ce56
SUBVAULT_ADDRESS=0x15EA3E50F91F36EFC17B66815451de22251EDAaD
REVSPLITTER_ADDRESS=0x1C4CEbbb4Cfa7fdb546424F21CF706c48C478EE6

# Ferrari Tokenomics v3.0
DEPOSIT_FEE_BPS=50
UNWRAP_RECYCLE_BPS=3000
UNWRAP_LP_BPS=7000
BBB_SPLIT_BPS=3000
LP_SPLIT_BPS=3000
VEXF_SPLIT_BPS=2500
TREASURY_SPLIT_BPS=1500

# ZK Configuration (SP1 zkVM - Production)
# SP1 prover URL set during deployment
# SP1_PROVER_URL=http://54.174.193.127:8080
# SP1_BATCHING_ENABLED=true
# SP1_BATCH_SIZE=10

# Legacy Groth16 config (Phase 0 - NOT USED IN PRODUCTION)
# These settings exist for historical reference only
# Production uses SP1 zkVM (see sp1-program/ directory)
# ZK_PROVING_TIMEOUT=2000
# ZK_CURVE=bn128
# ZK_PROTOCOL=groth16

# Deployment Settings
DEPLOY_MODE=simulation
AUTO_APPROVE=false
DRY_RUN=true

# Logging
LOG_LEVEL=info
VERBOSE=true

