# ─────────────────────────────────────────────────────────────────────────────
# XFuel hosted TESTNET demo endpoint — env template
#
# Powers api-testnet.xfuel.app: the M2M API + OpenAI-compatible gateway with a
# shared, rate-limited PUBLIC demo key. Copy to `.env` on the host and fill in
# the real key(s). Run with:  npm run m2m-server   (node src/server.js, port 3002)
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
M2M_API_PORT=3002
AI_LISTENER_ENABLED=true
LOG_LEVEL=info

# ── Reverse proxy ────────────────────────────────────────────────────────────
# REQUIRED behind Caddy/nginx: without it req.ip is the proxy loopback and every
# demo client shares ONE per-IP bucket. 'true' trusts X-Forwarded-For; use a hop
# count (e.g. 1) or a subnet string if you chain proxies.
M2M_TRUST_PROXY=true

# ── CORS (opt-in) ────────────────────────────────────────────────────────────
# Off unless set. Needed only for browser clients (playground/web app) hitting
# /v1/*. Use '*' for the open demo, or a specific origin. Server-side agents
# don't need this.
M2M_CORS_ORIGIN=

# ── Auth ─────────────────────────────────────────────────────────────────────
# PRIVATE keys (comma-separated) get the normal, generous rate limit. Set at
# least one so the server is NOT in open mode.
M2M_API_KEYS=change-me-private-key-1

# ── Public demo mode ─────────────────────────────────────────────────────────
# The shared demo key must match the SDK default (PUBLIC_DEMO_API_KEY = "xfuel-demo").
M2M_DEMO_MODE=true
M2M_DEMO_API_KEY=xfuel-demo
M2M_DEMO_RATE_PER_MIN=15
M2M_DEMO_RATE_PER_DAY=150

# ── OpenAI gateway ───────────────────────────────────────────────────────────
# Cap generation to gate GPU spend. Advertised model list (CSV).
OPENAI_GATEWAY_MAX_TOKENS_CAP=512
OPENAI_GATEWAY_MODELS=llama-3-70b,xfuel-auto

# ── Real compute (provider-agnostic router) ──────────────────────────────────
# Any provider present → real inference via the router; none → labelled mock.
# Theta EdgeCloud is one DePIN tier (use it when it has capacity).
THETA_EDGECLOUD_API_KEY=
# Provider-agnostic router on by default for /task-request (opt out with =false).
M2M_USE_FULL_ROUTER=true

# ── Generic OpenAI-compatible provider (recommended primary for demos) ────────
# Point at any OpenAI-shaped endpoint (OpenAI, Groq, Together, Fireworks, vLLM…).
# This is the most reliable route when DePIN tiers are cold — swap providers via
# env, no code change.
#   Groq (fast, cheap): OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
#                       OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_NAME=openai-compatible

# ── Claude (Anthropic) optional backstop ─────────────────────────────────────
# Appended after the generic tier. LLM only. Set the key to enable the tier.
ANTHROPIC_API_KEY=
# Set to the current Claude model slug for your account (override as needed).
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── ZK proving cost gate (Tier 1) ────────────────────────────────────────────
# Public demo pays for inference (cheap) but NOT for a proof on every call.
# Recommended live config: turn proving off globally and allow-list partner keys
# (e.g. a ZAN demo key). Signed receipt (Tier 0) is always returned.
#   PROVER_ENABLED=false
#   PROVER_ALLOW_KEYS=zan-partner-key,another-key
PROVER_ENABLED=true
PROVER_ALLOW_KEYS=

# ── ZK settlement proofs (optional) ──────────────────────────────────────────
# Present → async SP1 settlement proofs (receipt proof.status="pending").
# Absent  → receipt proof.status="unavailable" (compute still works).
SP1_PROVER_URL=

# ── Theta RPC (testnet 365) ──────────────────────────────────────────────────
THETA_RPC_URLS=https://eth-rpc-api-testnet.thetatoken.org/rpc

# ── x402 (leave OFF for the demo; OpenAI path is unmetered) ───────────────────
X402_ENABLED=false
# To make the USDC/x402 loop REAL on testnet, flip the block below on:
#   X402_ENABLED=true
#   X402_DEFAULT_RAIL=usdc
#   X402_FACILITATOR_PROVIDER=x402        # standard x402 (public Base Sepolia reference)
#   # X402_FACILITATOR_URL=               # blank → https://x402.org/facilitator (no key)
#   X402_NETWORK=base-sepolia
#   X402_PAY_TO=0x<your-base-sepolia-usdc-treasury>
#   X402_FALLBACK_TFUEL=true              # usdc unavailable → TFUEL instead of 503
#   X402_USDC_PRICE_DEFAULT=10000         # $0.01 (6dp)
