# Multi-platform Dockerfile for Persistence deployment
# Supports both ARM64 (default for VPS/EC2) and AMD64 (fallback)

FROM --platform=${BUILDPLATFORM:-linux/arm64} ubuntu:24.04

# Build arguments for platform detection
ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG TARGETARCH

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install essential dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    ca-certificates \
    jq \
    gnupg \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security (check if GID 1000 exists first)
RUN groupadd -g 1000 xfuel 2>/dev/null || groupadd xfuel && \
    useradd -u 1000 -g xfuel -m -s /bin/bash xfuel 2>/dev/null || \
    useradd -g xfuel -m -s /bin/bash xfuel

# Set working directory
WORKDIR /app

# Download platform-specific persistenceCore binary
# Latest version: v11.0.0+ (2026-compatible)
RUN ARCH=$(echo ${TARGETARCH:-arm64} | sed 's/amd64/x86_64/g' | sed 's/arm64/aarch64/g') && \
    echo "Downloading persistenceCore for architecture: $ARCH (${TARGETARCH:-arm64})" && \
    if [ "${TARGETARCH:-arm64}" = "arm64" ]; then \
        # ARM64 (default for modern VPS/EC2)
        curl -L "https://github.com/persistenceOne/persistenceCore/releases/download/v11.14.0/persistenceCore-v11.14.0-linux-arm64.tar.gz" -o persistenceCore.tar.gz; \
    else \
        # AMD64 (fallback)
        curl -L "https://github.com/persistenceOne/persistenceCore/releases/download/v11.14.0/persistenceCore-v11.14.0-linux-amd64.tar.gz" -o persistenceCore.tar.gz; \
    fi && \
    tar -xzf persistenceCore.tar.gz && \
    # Find and install the binary
    find . -name "persistenceCore" -type f -executable | head -1 | xargs -I {} mv {} /usr/local/bin/persistenceCore && \
    chmod +x /usr/local/bin/persistenceCore && \
    rm -rf persistenceCore.tar.gz release/ && \
    # Verify installation
    persistenceCore version --long || echo "Binary installed, will verify at runtime"

# Copy project files (owned by xfuel user)
COPY --chown=xfuel:xfuel . .

# Make scripts executable
RUN chmod +x scripts/*.sh 2>/dev/null || true

# Configure persistenceCore for mainnet
RUN mkdir -p /home/xfuel/.persistenceCore && \
    chown -R xfuel:xfuel /home/xfuel/.persistenceCore && \
    su - xfuel -c "persistenceCore config chain-id core-1" && \
    su - xfuel -c "persistenceCore config node https://rpc.core.persistence.one:443" && \
    su - xfuel -c "persistenceCore config keyring-backend test"

# Switch to non-root user
USER xfuel

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD persistenceCore version || exit 1

# Default command (keeps container running for exec)
CMD ["tail", "-f", "/dev/null"]
